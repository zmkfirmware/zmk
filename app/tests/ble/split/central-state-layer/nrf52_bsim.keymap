#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/kscan_mock.h>

&kscan {
    /delete-property/ exit-after;
    events =
    <ZMK_MOCK_PRESS(0,0,5000)
    ZMK_MOCK_RELEASE(0,0,1000)>;
};
/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "base";
            bindings = <
            &mo 1 &kp A
            &kp B &kp C>;
        };

        // 18 bytes: the 17 byte limit on the wire falls inside the last character
        lower_layer {
            display-name = "lower-layer-ÄÖÜ";
            bindings = <
            &trans &kp N1
            &kp N2 &kp N3>;
        };
    };
};
