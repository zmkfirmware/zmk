#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/kscan_mock.h>
#include <dt-bindings/zmk/led_matrix.h>
#include <dt-bindings/zmk/led_matrix_colors.h>
#include <dt-bindings/led/led.h>
#include <behaviors.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan;
        zmk,led-matrix = &led_matrix;
    };

    behaviors {
        test_hid_indicators: test_hid_indicators {
            compatible = "zmk,behavior-raise-hid-indicators";
            #binding-cells = <1>;
        };
    };

    kscan: native_posix_64_kscan_mock {
        compatible = "zmk,kscan-mock";
        rows = <1>;
        columns = <5>;
        exit-after;
        events = <
            ZMK_MOCK_PRESS(0,0,10)
            ZMK_MOCK_RELEASE(0,0,20)
            ZMK_MOCK_PRESS(0,1,120)
            ZMK_MOCK_RELEASE(0,1,20)
            ZMK_MOCK_PRESS(0,2,220)
            ZMK_MOCK_RELEASE(0,2,20)
            ZMK_MOCK_PRESS(0,3,320)
            ZMK_MOCK_RELEASE(0,3,20)
            ZMK_MOCK_PRESS(0,4,420)
            ZMK_MOCK_RELEASE(0,4,20)
        >;
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &test_hid_indicators 2
                &test_hid_indicators 3
                &test_hid_indicators 7
                &test_hid_indicators 15
                &test_hid_indicators 31
            >;
        };
    };

    led_matrix_dev: led_matrix_dev {
        compatible = "zmk,led-mock";
        mode = "color";

        led_0 { index = <0>; color-mapping = <LED_COLOR_ID_RED LED_COLOR_ID_GREEN LED_COLOR_ID_BLUE>; };
    };

    led_matrix: led_matrix {
        compatible = "zmk,led-matrix";
        led-driver = "matrix";
        led-device = <&led_matrix_dev>;
        led-count = <1>;
        status-timeout-ms = <1000>;
        hid-timeout-ms = <1000>;
        hid-caps-leds = <0>;
        hid-caps-color-on = <0xFF0000>;
        hid-caps-color-off = <LM_BLACK>;
        hid-num-leds = <0>;
        hid-num-color-on = <0x00FF00>;
        hid-num-color-off = <LM_BLACK>;
        hid-scroll-leds = <0>;
        hid-scroll-color-on = <0x0000FF>;
        hid-scroll-color-off = <LM_BLACK>;
        hid-compose-leds = <0>;
        hid-compose-color-on = <0xFFFF00>;
        hid-compose-color-off = <LM_BLACK>;
        hid-kana-leds = <0>;
        hid-kana-color-on = <0xFF00FF>;
        hid-kana-color-off = <LM_BLACK>;
        matrix-led-grid = <
            0
        >;

        profile0 {
            profile-id = <0>;
            display-name = "Off";
            renderer = "solid";
            colors = <LM_BLACK>;
            brightness = <100>;
            period-ms = <1000>;
        };
    };
};
