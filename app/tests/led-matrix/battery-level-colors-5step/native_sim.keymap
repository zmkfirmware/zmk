#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/kscan_mock.h>
#include <dt-bindings/zmk/led_matrix.h>
#include <dt-bindings/zmk/led_matrix_colors.h>
#include <dt-bindings/led/led.h>
#include <behaviors.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan;
        zmk,led-matrix = &led_matrix;
    };

    behaviors {
        test_battery_state: test_battery_state {
            compatible = "zmk,behavior-raise-battery-state";
            #binding-cells = <1>;
        };
    };

    kscan: native_posix_64_kscan_mock {
        compatible = "zmk,kscan-mock";
        rows = <1>;
        columns = <8>;
        exit-after;
        events = <
            ZMK_MOCK_PRESS(0,0,10)
            ZMK_MOCK_RELEASE(0,0,20)
            ZMK_MOCK_PRESS(0,1,120)
            ZMK_MOCK_RELEASE(0,1,20)
            ZMK_MOCK_PRESS(0,2,120)
            ZMK_MOCK_RELEASE(0,2,20)
            ZMK_MOCK_PRESS(0,3,120)
            ZMK_MOCK_RELEASE(0,3,20)
            ZMK_MOCK_PRESS(0,4,120)
            ZMK_MOCK_RELEASE(0,4,20)
            ZMK_MOCK_PRESS(0,5,120)
            ZMK_MOCK_RELEASE(0,5,20)
            ZMK_MOCK_PRESS(0,6,120)
            ZMK_MOCK_RELEASE(0,6,20)
            ZMK_MOCK_PRESS(0,7,120)
            ZMK_MOCK_RELEASE(0,7,20)
        >;
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &test_battery_state 20
                &test_battery_state 21
                &test_battery_state 40
                &test_battery_state 41
                &test_battery_state 60
                &test_battery_state 61
                &test_battery_state 80
                &test_battery_state 81
            >;
        };
    };

    led_matrix_dev: led_matrix_dev {
        compatible = "zmk,led-mock";
        mode = "color";

        led_0 { index = <0>; color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>; };
        led_1 { index = <1>; color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>; };
        led_2 { index = <2>; color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>; };
        led_3 { index = <3>; color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>; };
        led_4 { index = <4>; color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>; };
    };

    led_matrix: led_matrix {
        compatible = "zmk,led-matrix";
        led-driver = "matrix";
        led-device = <&led_matrix_dev>;
        led-count = <5>;
        status-timeout-ms = <300>;
        battery-timeout-ms = <300>;
        battery-leds = <0 1 2 3 4>;
        battery-level-colors = <LM_RED LM_ORANGE LM_YELLOW LM_GREEN LM_CYAN>;
        battery-color-off = <LM_BLACK>;
        matrix-led-grid = <
            0 1 2 3 4 LM_NOLED LM_NOLED LM_NOLED
        >;

        profile0 {
            profile-id = <0>;
            display-name = "Battery 5 Step";
            renderer = "solid";
            colors = <LM_BLACK>;
            brightness = <100>;
            period-ms = <1000>;
        };
    };
};
