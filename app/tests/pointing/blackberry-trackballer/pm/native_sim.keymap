#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

#include <behaviors.dtsi>
#include <dt-bindings/zmk/kscan_mock.h>

/ {
    behaviors {
        test_right: test_right {
            compatible = "zmk,behavior-gpio-emul-input";
            #binding-cells = <0>;
            gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
        };
        test_trackball_pm: test_trackball_pm {
            compatible = "zmk,behavior-pm-device-action";
            #binding-cells = <1>;
            device = <&trackball>;
        };
        test_button: test_button {
            compatible = "zmk,behavior-gpio-emul-input";
            #binding-cells = <0>;
            gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>;
        };
    };

    trackball: trackball {
        compatible = "sparkfun,blackberry-trackballer";
        left-gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
        right-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
        up-gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
        down-gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
        button-gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>;
        zephyr,axis-x = <INPUT_REL_X>;
        zephyr,axis-y = <INPUT_REL_Y>;
        report-period-ms = <4>;
        interpolation-frames = <4>;
        minimum-pulse-interval-us = <1000000>;
        minimum-step = <8>;
        maximum-step = <8>;
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &test_right
                &test_trackball_pm 0
                &test_trackball_pm 1
                &test_button
            >;
        };
    };
};

&kscan {
    events = <
        /* A reported press is released by suspend so it cannot remain stuck at the host. */
        ZMK_MOCK_PRESS(0,3,10)

        /* This pulse is discarded when suspend cancels the pending report. */
        ZMK_MOCK_PRESS(0,0,1)
        ZMK_MOCK_RELEASE(0,0,1)
        ZMK_MOCK_PRESS(0,1,1)
        ZMK_MOCK_RELEASE(0,1,5)

        /* Button transitions and movement while suspended are ignored. */
        ZMK_MOCK_RELEASE(0,3,1)
        ZMK_MOCK_PRESS(0,0,1)
        ZMK_MOCK_RELEASE(0,0,5)

        ZMK_MOCK_PRESS(0,2,1)
        ZMK_MOCK_RELEASE(0,2,5)

        /* Resume resets interpolation, filtering, and velocity state. */
        ZMK_MOCK_PRESS(0,0,1)
        ZMK_MOCK_RELEASE(0,0,30)
    >;
};
