# Enable MPU
CONFIG_ARM_MPU=y

CONFIG_PINCTRL=y
CONFIG_PM_DEVICE=y
CONFIG_PM_DEVICE_RUNTIME=y

# enable GPIO
CONFIG_GPIO=y

CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y

CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_SETTINGS_NVS_SECTOR_SIZE_MULT=1
CONFIG_SETTINGS_NVS_SECTOR_COUNT=16
CONFIG_ZMK_SETTINGS_SAVE_DEBOUNCE=5000
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y
CONFIG_INIT_STACKS=y
CONFIG_STACK_SENTINEL=y
CONFIG_ASSERT=y

CONFIG_ZMK_HID_INDICATORS=y

#CONFIG_ZMK_SLEEP=y
#CONFIG_ZMK_IDLE_SLEEP_TIMEOUT=3600000

CONFIG_ZMK_USB=y
CONFIG_ZMK_BLE=y

CONFIG_ZMK_STUDIO_LOCKING=n

CONFIG_ZMK_EXT_POWER=y

# LED matrix config
CONFIG_ZMK_LED_MATRIX=y
CONFIG_ZMK_LED_MATRIX_EXT_POWER=y
CONFIG_ZMK_LED_MATRIX_AUTO_OFF_IDLE=y
CONFIG_ZMK_LED_MATRIX_BRT_START=40
CONFIG_ZMK_LED_MATRIX_BRT_STEP=10
CONFIG_SYSTEM_WORKQUEUE_STACK_SIZE=4096
CONFIG_ZMK_LOW_PRIORITY_THREAD_STACK_SIZE=3072

CONFIG_ZMK_IDLE_TIMEOUT=15000
