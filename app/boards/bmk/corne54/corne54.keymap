#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/led_matrix.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/outputs.h>



&mt {
    tapping-term-ms = <200>;
};

&lt {
    tapping-term-ms = <200>;
};

&kscan0 {
    debounce-press-ms = <4>;
    debounce-release-ms = <4>;
};

/ {

    /* 
    behaviors {  
        htlk: hold_tap_layer_key {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;          
            tapping-term-ms = <200>;       
            flavor = "tap-preferred";    
            bindings = <&mo>, <&kp>;     
        };
    };
    */


    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <4 6>;
            then-layer = <5>;
        };
    };

    behaviors {
        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer On";
            toggle-mode = "on";
        };

		tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };
    };

    macros {
        m_w_zoom_in: w_zoom_in_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;       
            bindings = 
                <&macro_press &kp LCTRL>,        
                <&macro_tap &kp MINUS>,                  
                <&macro_release &kp LCTRL>;
        };

        m_w_zoom_out: w_zoom_out_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;       
            bindings = 
                <&macro_press &kp LCTRL>,        
                <&macro_tap &kp EQUAL>,                  
                <&macro_release &kp LCTRL>;
        };

        m_zoom_in: zoom_in_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;       
            bindings = 
                <&macro_press &kp LCMD>,        
                <&macro_tap &kp MINUS>,                  
                <&macro_release &kp LCMD>;
        };

        m_zoom_out: zoom_out_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;       
            bindings = 
                <&macro_press &kp LCMD>,        
                <&macro_tap &kp EQUAL>,                  
                <&macro_release &kp LCMD>;
        };

        switch_bt0: switch_to_bt_profile_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&tog_off 1>;
        };
        switch_bt1: switch_to_bt_profile_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&tog_on 1>;
        };

        switch_bt2: switch_to_bt_profile_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>, <&tog_off 1>;
        };

        switch_bt3: switch_to_bt_profile_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3>, <&tog_on 1>;
        };

        switch_bt4: switch_to_bt_profile_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4>, <&tog_off 1>;
        };


    };

    behaviors {
        zoom_in_out: rotate_zoom_in_out {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = 
                <&m_zoom_in>,        
                <&m_zoom_out>;
        }; 
        
        w_zoom_in_out: rotate_w_zoom_in_out {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = 
                <&m_w_zoom_in>, 
                <&m_w_zoom_out>;
        }; 

    };

    behaviors {
        gresc: grave_escape {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp GRAVE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };


    keymap {
        compatible = "zmk,keymap";
        
        default_layer {
            display-name = "Apple OS";
            //0
            bindings = <
                &kp ESC   &kp N1      &kp N2      &kp N3      &kp N4       &kp N5                         &kp N6      &kp N7      &kp N8    &kp N9   &kp N0   &kp BSPC
                &kp TAB   &kp Q       &kp W       &kp E       &kp R        &kp T                          &kp Y       &kp U       &kp I     &kp O    &kp P    &kp BSLH
                &kp CAPS  &kp A       &kp S       &kp D       &kp F        &kp G                          &kp H       &kp J       &kp K     &kp L    &kp SEMI &kp SQT
                &kp LSHFT &kp Z       &kp X       &kp C       &kp V        &kp B  &mo 3          &mo 3    &kp N       &kp M       &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
                                                  &mt LALT LBKT &mt LCMD RBKT &kp ENTER                   &kp SPACE   &mt RCTRL MINUS   &lt 4 EQUAL 
            >;

            sensor-bindings = <&inc_dec_kp LEFT RIGHT  &inc_dec_kp UP DOWN>;
        };

        win_layer {
            display-name = "Windows";
            //1
            bindings = <
                &kp ESC   &kp N1      &kp N2      &kp N3      &kp N4       &kp N5                         &kp N6      &kp N7      &kp N8    &kp N9   &kp N0   &kp BSPC
                &kp TAB   &kp Q       &kp W       &kp E       &kp R        &kp T                          &kp Y       &kp U       &kp I     &kp O    &kp P    &kp BSLH
                &kp CAPS  &kp A       &kp S       &kp D       &kp F        &kp G                          &kp H       &kp J       &kp K     &kp L    &kp SEMI &kp SQT
                &kp LSHFT &kp Z       &kp X       &kp C       &kp V        &kp B  &mo 3          &mo 3    &kp N       &kp M       &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
                                                  &mt LALT LBKT &mt LCTRL RBKT &kp ENTER                  &kp SPACE   &mt RCMD MINUS   &lt 4 EQUAL 
            >;

            sensor-bindings = <&inc_dec_kp LEFT RIGHT  &inc_dec_kp UP DOWN>;
        };

        numpad_layer {
            display-name = "NumPad";
            //2
            bindings = <
                &kp ESC   &kp KP_NLCK     &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp BSPC                                    &none  &kp KP_NLCK     &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp BSPC
                &kp TAB   &kp KP_DIVIDE   &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp KP_MINUS                                &none  &kp KP_DIVIDE   &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp KP_MINUS
                &kp CAPS  &kp KP_MULTIPLY &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_PLUS                                 &none  &kp KP_MULTIPLY &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_PLUS
                &kp LSHFT &none           &kp KP_N0 &kp KP_DOT  &kp KP_EQUAL &kp KP_ENTER  &mo 3          &mo 3     &none  &none           &kp KP_N0 &kp KP_DOT  &kp KP_EQUAL &kp KP_ENTER
                                                    &trans      &trans       &kp ENTER                              &kp SPACE    &trans      &trans
            >;
            sensor-bindings = <&inc_dec_kp LEFT RIGHT  &inc_dec_kp UP DOWN>;
        };
        navi_layer {
            display-name = "Navi";
            //3
            bindings = <
                &trans   &trans      &trans      &trans      &trans       &trans                         &trans      &trans      &trans   &trans   &trans   &trans
                &trans   &trans      &trans      &trans      &trans       &trans                         &trans      &trans      &trans   &trans   &trans   &trans
                &trans   &trans      &trans      &trans      &trans       &trans                         &trans      &trans      &trans   &trans   &trans   &trans
                &trans   &trans      &trans      &trans      &trans       &trans &mo 3          &mo 3    &trans      &trans      &trans   &trans   &trans   &trans
                                                 &trans      &trans       &kp ENTER                      &kp SPACE   &trans      &trans
            >;
            sensor-bindings = <&inc_dec_kp UP DOWN  &inc_dec_kp LEFT RIGHT>;
        };                      
        fn_layer {
            display-name = "Fn";
            //4
            bindings = <
                &kp GRAVE &kp C_BRI_DN &kp C_BRI_UP  &kp C_AC_DESKTOP_SHOW_ALL_APPLICATIONS &kp C_AC_SEARCH &kp C_VOICE_COMMAND  &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS &kp C_PREV &kp C_PP &kp C_NEXT &kp C_MUTE &kp DEL 
                &trans      &trans        &trans       &kp UP     &out OUT_USB &out OUT_BLE                                      &kp C_VOL_UP &lm LM_EFF    &lm LM_SPI      &lm LM_BRI      &lm LM_HUI      &lm LM_TOG
                &trans      &tog 1        &kp LEFT     &kp DOWN   &kp RIGHT    &trans                                            &kp C_VOL_DN &lm LM_EFR    &lm LM_SPD      &lm LM_BRD      &lm LM_HUD      &lm LM_STA LM_STA_ALL 
                &trans      &switch_bt0   &switch_bt1  &switch_bt2 &switch_bt3 &bt BT_CLR   &trans                   &trans      &kp INS      &kp HOME      &kp END         &kp PG_UP       &kp PG_DN       &trans  
                                                       &tog 6     &tog 2       &kp SPACE                                         &kp ENTER &trans &lt 4 EQUAL
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PAGE_UP PAGE_DOWN >;
 
        };
        fx_layer {
            display-name = "Fx Functions";
            //5
            bindings = <
                &trans      &kp F1      &kp F2      &kp F3      &kp F4       &kp F5                         &kp F6  &kp F7      &kp F8      &kp F9  &kp F10 &trans
                &trans      &trans      &trans      &trans      &trans       &trans                         &trans  &trans      &trans      &trans  &trans  &trans 
                &trans      &trans      &trans      &trans      &trans       &trans                         &trans  &trans      &trans      &trans  &trans  &trans 
                &trans      &trans      &trans      &trans      &trans       &trans  &trans       &trans    &trans  &trans      &trans      &trans  &trans  &trans 
                                                    &trans      &trans       &trans                         &kp F11 &kp F12     &trans 
            >;

        };
        fxFun_layer {
            display-name = "Fx Functions";
            //6
            bindings = <
                &trans      &trans      &trans      &trans      &trans       &trans                         &trans  &trans      &trans      &trans  &trans  &trans
                &trans      &trans      &trans      &trans      &trans       &trans                         &trans  &trans      &trans      &trans  &trans  &trans 
                &trans      &trans      &trans      &trans      &trans       &trans                         &trans  &trans      &trans      &trans  &trans  &trans 
                &trans      &trans      &trans      &trans      &trans       &trans  &trans       &trans    &trans  &trans      &trans      &trans  &trans  &trans 
                                                    &trans      &trans       &trans                         &trans  &trans      &trans
            >;
        };
    };
};
