# Enable MPU
CONFIG_ARM_MPU=y

# enable GPIO
CONFIG_GPIO=y

# Enable SPI for LEDS
CONFIG_PINCTRL=y
CONFIG_SPI=y
CONFIG_SPI_NRFX=y

# Enable writing to flash
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

# Keyboard IDs
CONFIG_ZMK_KEYBOARD_NAME="Corne54v3 Right"
CONFIG_USB_DEVICE_PID=0x27dd
CONFIG_USB_DEVICE_VID=0x16c2
CONFIG_USB_DEVICE_MANUFACTURER="BMK"
CONFIG_USB_DEVICE_SN="corne54v3rt20244"

CONFIG_BT_DIS_PNP_PID=0x27df
CONFIG_BT_DIS_PNP_VID=0x16c2
CONFIG_BT_DIS_MANUF="BMK"
CONFIG_BT_DIS_MODEL="Corne54v3"

# Enable 32kHz crystal
#CONFIG_CLOCK_CONTROL_NRF_K32SRC_XTAL=y
#CONFIG_CLOCK_CONTROL_NRF_K32SRC_150PPM=y

CONFIG_ZMK_EXT_POWER=y

# LED matrix config
CONFIG_ZMK_LED_MATRIX=y
CONFIG_ZMK_LED_MATRIX_AUTO_OFF_IDLE=y
CONFIG_ZMK_LED_MATRIX_EXT_POWER=y
CONFIG_ZMK_LED_MATRIX_ON_START=n
CONFIG_ZMK_LED_MATRIX_BRT_START=40
CONFIG_ZMK_LED_MATRIX_BRT_STEP=10
CONFIG_ZMK_LED_MATRIX_PROFILE_START=0

#Backlighting configuration
#CONFIG_PWM=y
#CONFIG_LED_PWM=y
#CONFIG_ZMK_BACKLIGHT=y
#CONFIG_ZMK_BACKLIGHT_BRT_START=20
#CONFIG_ZMK_BACKLIGHT_AUTO_OFF_IDLE=y

#Misc configuration
#CONFIG_BT_CTLR_TX_PWR_PLUS_8=y
CONFIG_ZMK_HID_REPORT_TYPE_NKRO=y
CONFIG_ZMK_HID_CONSUMER_REPORT_USAGES_BASIC=y
CONFIG_BUILD_OUTPUT_UF2=y
CONFIG_ZMK_BLE=y

#CONFIG_ZMK_DISPLAY=y
#CONFIG_ZMK_DISPLAY_STATUS_SCREEN_BUILT_IN=y
#CONFIG_ZMK_DISPLAY_WORK_QUEUE_DEDICATED=y
#CONFIG_ZMK_DISPLAY_STATUS_SCREEN_CUSTOM=y
#CONFIG_ZMK_WIDGET_WPM_STATUS=y

# Enable nice!view
CONFIG_ZMK_DISPLAY=y
#CONFIG_ZMK_DISPLAY_STATUS_SCREEN_CUSTOM=y
# Disable idle blanking
CONFIG_ZMK_DISPLAY_BLANK_ON_IDLE=y
#CONFIG_ZMK_WIDGET_WPM_STATUS=y
CONFIG_ZMK_LV_FONT_DEFAULT_SMALL_MONTSERRAT_16=y
CONFIG_LVGL=y
CONFIG_ZMK_DISPLAY_TICK_PERIOD_MS=250

CONFIG_LV_Z_MEM_POOL_SIZE=8192

#CONFIG_EC11_TRIGGER_OWN_THREAD=y
CONFIG_EC11_TRIGGER_GLOBAL_THREAD=y

CONFIG_ZMK_STUDIO_LOCKING=n
CONFIG_ZMK_HID_INDICATORS=y

CONFIG_ZMK_IDLE_TIMEOUT=15000
CONFIG_ZMK_SLEEP=y
CONFIG_ZMK_IDLE_SLEEP_TIMEOUT=3600000

CONFIG_ZMK_BATTERY_REPORTING=y
CONFIG_ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_PROXY=y
CONFIG_ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING=y

