if BOARD_CORNE54V2_LEFT

config ZMK_KEYBOARD_NAME
    default "CORNE54V2"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif # BOARD_CORNE54V2_LEFT

if BOARD_CORNE54V2_RIGHT

config ZMK_KEYBOARD_NAME
    default "CORNE54V2 right"

endif # BOARD_CORNE54V2_RIGHT


if BOARD_CORNE54V2_LEFT || BOARD_CORNE54V2_RIGHT

config BOARD
    default "CORNE54V2"

config ZMK_SPLIT
    default y

config SPI
    default y

config BT_CTLR
    default BT

if USB

config USB_NRFX
    default y

config USB_DEVICE_STACK
    default y

endif # USB

config ZMK_BATTERY_VOLTAGE_DIVIDER
    default y

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

endif # ZMK_DISPLAY

if ZMK_RGB_UNDERGLOW

config SPI
    default y

endif # ZMK_RGB_UNDERGLOW


if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # LVG


endif # BOARD_CORNE54V2_LEFT || BOARD_CORNE54V2_RIGHT
