#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>



&mt {
    tapping-term-ms = <200>;
};

&lt {
    tapping-term-ms = <200>;
};

&kscan0 {
    debounce-press-ms = <4>;
    debounce-release-ms = <4>;
};

/ {

    /* 
    behaviors {  
        htlk: hold_tap_layer_key {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;          
            tapping-term-ms = <200>;       
            flavor = "tap-preferred";    
            bindings = <&mo>, <&kp>;     
        };
    };
    */


    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <4 6>;
            then-layer = <5>;
        };
    };

    behaviors {
        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer On";
            toggle-mode = "on";
        };

		tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };
    };

    macros {
        m_w_zoom_in: w_zoom_in_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;       
            bindings = 
                <&macro_press &kp LCTRL>,        
                <&macro_tap &kp MINUS>,                  
                <&macro_release &kp LCTRL>;
        };

        m_w_zoom_out: w_zoom_out_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;       
            bindings = 
                <&macro_press &kp LCTRL>,        
                <&macro_tap &kp EQUAL>,                  
                <&macro_release &kp LCTRL>;
        };

        m_zoom_in: zoom_in_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;       
            bindings = 
                <&macro_press &kp LCMD>,        
                <&macro_tap &kp MINUS>,                  
                <&macro_release &kp LCMD>;
        };

        m_zoom_out: zoom_out_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;       
            bindings = 
                <&macro_press &kp LCMD>,        
                <&macro_tap &kp EQUAL>,                  
                <&macro_release &kp LCMD>;
        };

        switch_bt0: switch_to_bt_profile_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&tog_off 1>;
        };
        switch_bt1: switch_to_bt_profile_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&tog_on 1>;
        };

        switch_bt2: switch_to_bt_profile_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>, <&tog_off 1>;
        };

        switch_bt3: switch_to_bt_profile_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3>, <&tog_off 1>;
        };


    };

    behaviors {
        zoom_in_out: rotate_zoom_in_out {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = 
                <&m_zoom_in>,        
                <&m_zoom_out>;
        }; 
        
        w_zoom_in_out: rotate_w_zoom_in_out {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = 
                <&m_w_zoom_in>, 
                <&m_w_zoom_out>;
        }; 

    };

        behaviors {
        gresc: grave_escape {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp GRAVE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };


    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Apple OS";
            bindings = <
                &kp ESC   &kp N1      &kp N2      &kp N3      &kp N4       &kp N5                                     &kp N6      &kp N7      &kp N8    &kp N9   &kp N0   &kp BSPC
                &kp TAB   &kp Q       &kp W       &kp E       &kp R        &kp T                   &kp UP             &kp Y       &kp U       &kp I     &kp O    &kp P    &kp BSLH
                &kp CAPS  &kp A       &kp S       &kp D       &kp F        &kp G           &kp LEFT &mo 3 &kp RIGHT   &kp H       &kp J       &kp K     &kp L    &kp SEMI &kp SQT
                &kp LSHFT &kp Z       &kp X       &kp C       &kp V        &kp B  &mo 3             &kp DOWN          &kp N       &kp M       &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
                                                  &mt LALT LBKT &mt LCMD RBKT &kp ENTER                               &kp SPACE   &mt RCTRL MINUS   &lt 4 EQUAL 
            >;

            sensor-bindings = <&inc_dec_kp LEFT RIGHT>;
        };

        win_layer {
            display-name = "Windows";
            bindings = <
                &kp ESC   &kp N1      &kp N2      &kp N3      &kp N4       &kp N5                                     &kp N6      &kp N7      &kp N8    &kp N9   &kp N0   &kp BSPC
                &kp TAB   &kp Q       &kp W       &kp E       &kp R        &kp T                    &kp UP            &kp Y       &kp U       &kp I     &kp O    &kp P    &kp BSLH
                &kp CAPS  &kp A       &kp S       &kp D       &kp F        &kp G           &kp LEFT &mo 3 &kp RIGHT   &kp H       &kp J       &kp K     &kp L    &kp SEMI &kp SQT
                &kp LSHFT &kp Z       &kp X       &kp C       &kp V        &kp B  &mo 3             &kp DOWN          &kp N       &kp M       &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
                                                  &mt LALT LBKT &mt LCTRL RBKT &kp ENTER                              &kp SPACE   &mt RCMD MINUS   &lt 4 EQUAL 
            >;

            sensor-bindings = <&inc_dec_kp LEFT RIGHT>;
        };

        numpad_layer {
            display-name = "NumPad";
            bindings = <
                &kp ESC   &kp N1      &kp N2      &kp N3      &kp N4       &kp N5                                   &none  &kp KP_NLCK     &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp BSPC
                &kp TAB   &kp Q       &kp W       &kp E       &kp R        &kp T                   &kp UP           &none  &kp KP_DIVIDE   &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp KP_MINUS
                &kp CAPS  &kp A       &kp S       &kp D       &kp F        &kp G          &kp LEFT &mo 3 &kp RIGHT  &none  &kp KP_MULTIPLY &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_PLUS
                &kp LSHFT &kp Z       &kp X       &kp C       &kp V        &kp B  &mo 3            &kp DOWN         &none  &none           &kp KP_N0 &kp KP_DOT  &kp KP_EQUAL &kp KP_ENTER
                                                  &trans      &trans       &kp ENTER                                &kp SPACE    &trans      &trans
            >;
            sensor-bindings = <&inc_dec_kp LEFT RIGHT>;
        };
        navi_layer {
            display-name = "Navi";
            bindings = <
                &trans   &trans      &trans      &trans      &trans       &trans                                   &trans      &trans      &trans   &trans   &trans   &trans
                &trans   &trans      &trans      &trans      &trans       &trans                  &trans           &trans      &trans      &trans   &trans   &trans   &trans
                &trans   &trans      &trans      &trans      &trans       &trans         &trans   &trans  &trans   &trans      &trans      &trans   &trans   &trans   &trans
                &trans   &trans      &trans      &trans      &trans       &trans &mo 3            &trans           &trans      &trans      &trans   &trans   &trans   &trans
                                                 &trans      &trans       &kp ENTER                                 &kp SPACE   &trans      &trans
            >;
            sensor-bindings = < &inc_dec_kp UP DOWN>;
        };
        fn_layer {
            display-name = "Fn";
            bindings = <
                &kp GRAVE &kp C_BRI_DN &kp C_BRI_UP  &kp C_AC_DESKTOP_SHOW_ALL_APPLICATIONS &kp C_AC_SEARCH &kp C_VOICE_COMMAND  &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS &kp C_PREV &kp C_PP &kp C_NEXT &kp C_MUTE &kp DEL 
                &trans      &trans        &trans       &kp UP     &trans       &trans                              &trans          &kp C_VOL_UP &rgb_ug RGB_SPI &rgb_ug RGB_SAI &rgb_ug RGB_HUI &rgb_ug RGB_BRI &rgb_ug RGB_TOG
                &trans      &tog 1        &kp LEFT     &kp DOWN   &kp RIGHT    &bt BT_CLR                   &trans &trans &trans   &kp C_VOL_DN &rgb_ug RGB_SPD &rgb_ug RGB_SAD &rgb_ug RGB_HUD &rgb_ug RGB_BRD &rgb_ug RGB_EFF 
                &trans      &switch_bt0   &switch_bt1  &switch_bt2 &switch_bt3 &switch_bt4  &trans                  &trans          &kp INS &kp HOME         &kp END        &kp PG_UP       &kp PG_DN       &trans  
                                                       &tog 6     &tog 2       &kp SPACE                                           &kp ENTER &trans &lt 4 EQUAL
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOL_UP >;
 
        }; 
        fx_layer {
            display-name = "Fx Functions";
            bindings = <
                &trans      &kp F1      &kp F2      &kp F3      &kp F4       &kp F5                                 &kp F6  &kp F7      &kp F8      &kp F9  &kp F10 &trans
                &trans      &trans      &trans      &trans      &trans       &trans                 &trans          &trans  &trans      &trans      &trans  &trans  &trans 
                &trans      &trans      &trans      &trans      &trans       &trans         &trans  &trans &trans   &trans  &trans      &trans      &trans  &trans  &trans 
                &trans      &trans      &trans      &trans      &trans       &trans  &trans         &trans          &trans  &trans      &trans      &trans  &trans  &trans 
                                                    &trans      &trans       &trans                                 &kp F11 &kp F12     &trans 
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN >;
        };
        fxFun_layer {
            display-name = "Fx Functions";
            bindings = <
                &trans      &trans      &trans      &trans      &trans       &trans                                 &trans  &trans      &trans      &trans  &trans  &trans
                &trans      &trans      &trans      &trans      &trans       &trans                 &trans          &trans  &trans      &trans      &trans  &trans  &trans 
                &trans      &trans      &trans      &trans      &trans       &trans         &trans  &trans &trans   &trans  &trans      &trans      &trans  &trans  &trans 
                &trans      &trans      &trans      &trans      &trans       &trans  &trans         &trans          &trans  &trans      &trans      &trans  &trans  &trans 
                                                    &trans      &trans       &trans                                 &trans  &trans      &trans
            >;
        };
    };
};
