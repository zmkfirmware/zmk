#include <behaviors.dtsi>
#include <dt-bindings/numpad-calculator.h>
#include <dt-bindings/zmk/keys.h>
//#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/led_matrix.h>

/ {

    /* 
    behaviors {  
        htlk: hold_tap_layer_key {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;          
            tapping-term-ms = <200>;       
            flavor = "tap-preferred";    
            bindings = <&mo>, <&kp>;     
        };
    };
    


    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <4 6>;
            then-layer = <5>;
        };
    };
*/
    behaviors {
        calc: calculator {
            compatible = "zmk,behavior-numpad-calculator";
            #binding-cells = <1>;
            calculator-layer = <CALC_LAYER>;
            function-layer = <CALC_FN_LAYER>;
            display-name = "Calculator";
        };
        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer On";
            toggle-mode = "on";
        };

		tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };
    };

    macros {
        m_w_zoom_in: w_zoom_in_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;       
            bindings = 
                <&macro_press &kp LCTRL>,        
                <&macro_tap &kp MINUS>,                  
                <&macro_release &kp LCTRL>;
        };

        m_w_zoom_out: w_zoom_out_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;       
            bindings = 
                <&macro_press &kp LCTRL>,        
                <&macro_tap &kp EQUAL>,                  
                <&macro_release &kp LCTRL>;
        };

        m_zoom_in: zoom_in_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;       
            bindings = 
                <&macro_press &kp LCMD>,        
                <&macro_tap &kp MINUS>,                  
                <&macro_release &kp LCMD>;
        };

        m_zoom_out: zoom_out_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;       
            bindings = 
                <&macro_press &kp LCMD>,        
                <&macro_tap &kp EQUAL>,                  
                <&macro_release &kp LCMD>;
        };

        switch_bt0: switch_to_bt_profile_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&tog_off 1>;
        };

        switch_bt1: switch_to_bt_profile_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&tog_on 1>;
        };

        switch_bt2: switch_to_bt_profile_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>, <&tog_off 1>;
        };

        switch_bt3: switch_to_bt_profile_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3>, <&tog_off 1>;
        };


    };

    behaviors {
        gresc: grave_escape {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp GRAVE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

	keymap {
		compatible = "zmk,keymap";
		
		default_layer {
// ------------------------------------
// | NumLck |   DEL |   BS  |    /  | 
// |    7   |   8   |   9   |    x  |
// |    4   |   5   |   6   |    -  |
// |    1   |   2   |   3   |    +  |
// |  MO(1) |   .   |   0   |    =  |
// ------------------------------------
			display-name = "Base";
			//0
			bindings = <
	&kp KP_NLCK  &kp DEL        &kp BSPC         &kp KP_DIVIDE
	&kp KP_N7    &kp KP_N8      &kp KP_N9        &kp KP_MULTIPLY
	&kp KP_N4    &kp KP_N5      &kp KP_N6        &kp KP_MINUS 
	&kp KP_N1    &kp KP_N2      &kp KP_N3        &kp KP_PLUS  
	&mo 2        &kp KP_N0      &kp KP_DOT       &kp KP_ENTER
			>;
		};

		media_layer {
// ------------------------------------
// | NumLck | 	    | 	    | 	Mute	| 
// |        |In Bri	|Eject	|Volume Down|
// |Previous|Play/PS| Next	|Volume Up	|
// |        |De Bri	|  Stop | 	   		|
// |  MO(1) |       |       |   ENT 	|
// ------------------------------------
			display-name = "Media";  
			//1
			bindings = <
	&kp KP_NLCK  &none         &none            &kp C_MUTE 
	&none        &kp C_BRI_UP  &kp C_EJECT      &kp C_VOL_DN 
	&kp C_PREV   &kp C_PLAY    &kp C_NEXT       &kp C_VOL_UP 
	&none        &kp C_BRI_DN  &kp C_STOP       &none 
	&mo 2        &none         &none            &kp KP_ENTER
				>;
			};

		func_layer {
// --------------------------------------
// |        |        | BT CLR |        | 
// | RGB_SAI| RGB_HUI| RGB_BRI| RGB_TOG| 
// | RGB_SAD| RGB_HUD| RGB_BRD| RGB_EFF| 
// |  BT 0  |  BT 1  |  BT 2  |  BT 2  | 
// |  MO(1) |        |        | tog 1  |
// --------------------------------------
			display-name = "Fn";
			//2
			bindings = <
	&calc CALC_TOGGLE &bl BL_TOG 		&bt BT_CLR      	&lm LM_STA LM_STA_ALL
	&lm LM_SPI      &lm LM_BRI      &lm LM_HUI          &lm LM_TOG
	&lm LM_SPD      &lm LM_BRD      &lm LM_HUD          &lm LM_EFF
	&bt BT_SEL 0 	&bt BT_SEL 1 	&bt BT_SEL 2 		&bt BT_SEL 3 
	&mo 2       	&none 			&out OUT_TOG		&tog 1
			>;
		};

        calculator_layer {
            display-name = "Cal";
            bindings = <
                &none          &calc DEL   &calc BSPC  &calc KP_DIVIDE
                &calc KP_N7    &calc KP_N8 &calc KP_N9 &calc KP_MULTIPLY
                &calc KP_N4    &calc KP_N5 &calc KP_N6 &calc KP_MINUS
                &calc KP_N1    &calc KP_N2 &calc KP_N3 &calc KP_PLUS
                &mo CALC_FN_LAYER &calc KP_N0 &calc KP_DOT &calc KP_ENTER
            >;
        };
        calculator_fn_layer {
            display-name = "Cal Fn";
            bindings = <
                &calc CALC_TOGGLE &bl BL_TOG &bt BT_CLR &lm LM_STA LM_STA_ALL
                &lm LM_SPI &lm LM_BRI &lm LM_HUI &lm LM_TOG
                &lm LM_SPD &lm LM_BRD &lm LM_HUD &lm LM_EFF
                &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3
                &mo CALC_FN_LAYER &none &out OUT_TOG &calc CALC_SEND
            >;
        };
	};
};
