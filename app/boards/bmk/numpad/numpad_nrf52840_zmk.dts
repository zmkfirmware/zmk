/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/led_matrix.h>
#include <dt-bindings/zmk/led_matrix_colors.h>
//#include <dt-bindings/zmk/backlight.h>
#include <common/nordic/nrf52840_uf2_boot_mode.dtsi>

#include "numpad_layouts.dtsi"
#include "numpad-pinctrl.dtsi"

/ {
	model = "numpad";
	compatible = "bmk,numpad";

	chosen {
		zephyr,code-partition = &code_partition;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zmk,kscan = &kscan0;
		zmk,backlight = &backlight;
		//zephyr,display = &oled;
		//zephyr,display = &nice_view;
		zephyr,display = &st75256_display;
		//zephyr,display = &st7789;
		zmk,battery = &vbatt;
		zmk,led-matrix = &led_matrix;
		zmk,physical-layout = &layout_numpad;
	};

	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <4>;
		rows = <5>;
		map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) 
RC(1,0) RC(1,1) RC(1,2) RC(1,3) 
RC(2,0) RC(2,1) RC(2,2) RC(2,3)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) 
RC(4,0) RC(4,1) RC(4,2) RC(4,3)
		>;
	};

	kscan0: kscan {
		compatible = "zmk,kscan-gpio-matrix";
		label = "KSCAN";
		diode-direction = "row2col";
		wakeup-source;
		row-gpios
			= <&gpio1 2 GPIO_ACTIVE_HIGH>
			, <&gpio1 4 GPIO_ACTIVE_HIGH>
			, <&gpio1 6 GPIO_ACTIVE_HIGH>
			, <&gpio0 9 GPIO_ACTIVE_HIGH>
			, <&gpio0 10 GPIO_ACTIVE_HIGH>
			;
		col-gpios
			= <&gpio0 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			;
	};

	backlight: backlight {
		compatible = "gpio-leds";
		screen_backlight: screen_backlight {
			gpios = <&gpio0 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
			label = "SCREEN_BACKLIGHT";
		};
	};

	/*
	leds {
		compatible = "gpio-leds";
		white_led: led_0 {
			gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;
			label = "White_LED";
		};
	};


	lcd_light {
		compatible = "gpio-leds";
		lcd_light_sw: lcd_light {
			gpios = <&gpio0 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
			label = "LCD_LIGHT";
		};
	};
 
	lcd_power {
		compatible = "gpio-leds";
		lcd_power_sw: lcd_power {
			gpios = <&gpio0 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
			label = "LCD_POWER";
		};
	};


	backlight: pwmleds {
		compatible = "pwm-leds";
		pwm_led_0 {
			pwms = <&pwm0 0 PWM_MSEC(10) PWM_POLARITY_NORMAL>;
		};
	
	};
