	EXT_POWER {
        compatible = "zmk,ext-power-generic";
        control-gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
    };

		led_matrix: led_matrix {
			compatible = "zmk,led-matrix";
			led-driver = "matrix";

			/*
			* Additional independent RGB test row:
			* CS7 common anode
			* RGB20: SW1=G  SW2=R  SW3=B
			* RGB21: SW4=G  SW5=R  SW6=B
			* RGB22: SW7=G  SW8=R  SW9=B
			* RGB23: SW10=G SW11=R SW12=B
			
			channel-indexes = <
				16 0 32   64 48 80   112 96 128   160 144 176
				17 1 33   65 49 81   113 97 129   161 145 177
				18 2 34   66 50 82   114 98 130   162 146 178
				19 3 35   67 51 83   115 99 131   163 147 179
				20 4 36   68 52 84   116 100 132  164 148 180
				22 6 38   70 54 86   118 102 134  166 150 182
			>;
			independent-leds = <20 21 22 23>;
			*/

			led-device = <&is31_led>;
			led-count = <20>;
			output-channel-count = <144>;

			/*
			 * ZMK channel-indexes are ordered R, G, B.
			 * Entries use the ZMK IS31FL3737 driver's dense flattened channel
			 * space (0..143).
			 *
			 * The driver restores the device's sparse PWM register layout
			 * internally, so this table should stay in dense channel space
			 * rather than raw page offsets.
			 */

			channel-indexes = <
				12 0 24   48 36 60   84 72 96   120 108 132
				13 1 25   49 37 61   85 73 97   121 109 133
				14 2 26   50 38 62   86 74 98   122 110 134
				15 3 27   51 39 63   87 75 99   123 111 135
				16 4 28   52 40 64   88 76 100  124 112 136
			>;

			matrix-led-grid = <
				0 1 2 3 LM_BREAK
				4 5 6 7 LM_BREAK
				8 9 10 11 LM_BREAK
				12 13 14 15 LM_BREAK
				16 17 18 19
			>;
		status-timeout-ms = <3000>;
		ble-pairing-hold = <1>;

		battery-leds = <4 5 6 7>;
		//battery-color-on = <LM_RED LM_ORANGE LM_YELLOW LM_GREEN>;
		battery-color-off = <LM_BLACK>;
		battery-level-colors = <LM_RED LM_ORANGE LM_YELLOW LM_GREEN>;
		

		ble-profile-leds = <12 13 14 15>;
		ble-color-open = <LM_BLUE>;
        ble-color-connected = <LM_CYAN>;
        ble-color-disconnected = <LM_RED>;

		hid-num-leds = <0>;
		hid-num-color-on = <LM_WHITE>;
		hid-num-color-off = <LM_BLACK>;

		profile0 {
			profile-id = <0>;
			display-name = "Palette Static";
			renderer = "solid";
			colors = <LM_PALETTE>;
			brightness = <100>;
			period-ms = <1500>;
		};

		profile1 {
            profile-id = <1>;
            display-name = "Swirl";
            renderer = "swirl";
            colors = <LM_DIM_CYAN>;
            brightness = <100>;
            period-ms = <2200>;
		};

		profile2 {
            profile-id = <2>;
            display-name = "Spectrum";
            renderer = "spectrum";
            colors = <LM_DIM_AMBER>;
            brightness = <100>;
            period-ms = <2200>;
        };



		profile3 {
			profile-id = <3>;
			display-name = "Keypress";
			renderer = "keypress";
			independent-led-mode = "static";
			keypress-afterglow-ms = <1000>;
			keypress-fadeout-ms = <250>;
			keypress-range = <0>;
			colors = <LM_PALETTE>;
			brightness = <100>;
			period-ms = <350>;
        };

        profile4 {
            profile-id = <4>;
            display-name = "Ripple";
            renderer = "ripple";
            colors = <LM_PALETTE>;
            brightness = <100>;
            period-ms = <1500>;
        };

        profile5 {
            profile-id = <5>;
            display-name = "Rain";
            renderer = "rain";
            colors = <LM_DIM_CYAN>;
            brightness = <100>;
            period-ms = <1400>;
        };

        profile6 {
            profile-id = <6>;
            display-name = "Starlight";
            renderer = "starlight";
            colors = <LM_DIM_WHITE>;
            brightness = <100>;
            period-ms = <2200>;
        };

	};

/*
	ext-power {
		compatible = "zmk,ext-power-generic";
		label = "EXT_POWER";
		control-gpios = <&gpio0 12 GPIO_ACTIVE_LOW>;
	};
*/

	vbatt: vbatt {
		compatible = "zmk,battery-voltage-divider";
		label = "BATTERY";
		io-channels = <&adc 2>;
		output-ohms = <2000000>;
		full-ohms = <(2000000 + 806000)>;
	};
