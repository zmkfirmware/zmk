&spi1 {
	compatible = "nordic,nrf-spim";
	pinctrl-0 = <&spi1_default>;
	pinctrl-1 = <&spi1_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;
	status = "okay";
};

/ {
	mipi_dbi_st75256: mipi-dbi-st75256 {
		compatible = "zephyr,mipi-dbi-spi";
		spi-dev = <&spi1>;
		dc-gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;
		write-only;
		#address-cells = <1>;
		#size-cells = <0>;

		st75256_display: st75256@0 {
			compatible = "sitronix,st75256";
			reg = <0>;
			mipi-max-frequency = <1000000>;
			mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
			width = <256>;
			height = <160>;
			duty = <159>;
			fi-settings = <0x0e>;
			bias-ratio = <4>;
			booster-frequency = <1>;
			flip-configuration = <0>;
			/* inversion-on; */
			lsb-invdir;
			light-grey = <0x08>;
			dark-grey = <0x18>;
			power-control = <0x0b>;
		};
	};
};

