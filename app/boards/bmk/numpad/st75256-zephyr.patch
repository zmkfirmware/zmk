+menuconfig ST75256
+	bool "ST75256 display controller"
+	default y
+	depends on DT_HAS_SITRONIX_ST75256_ENABLED
+	select MIPI_DBI
+	help
+	  Enable driver for ST75256 display controller.
+
+if ST75256
+
+config ST75256_DEFAULT_CONTRAST
+	int "ST75256 default contrast"
+	default 155
+	range 0 255
+	help
