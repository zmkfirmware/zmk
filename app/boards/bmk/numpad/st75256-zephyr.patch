+
+#ifndef ZEPHYR_INCLUDE_DISPLAY_ST75256_H_
+#define ZEPHYR_INCLUDE_DISPLAY_ST75256_H_
+
+#include <zephyr/drivers/display.h>
+#include <zephyr/sys/util_macro.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * @brief Private 8-bit grayscale input format for ST75256.
+ *
+ * This format is not part of Zephyr's generic display pixel formats. When
+ * selected with @ref display_set_pixel_format, @ref display_write expects one
+ * byte of luminance per pixel and the driver converts it to the controller's
+ * 4-level vertically tiled format.
+ */
+#define ST75256_PIXEL_FORMAT_L_8 ((enum display_pixel_format)BIT(6))
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* ZEPHYR_INCLUDE_DISPLAY_ST75256_H_ */
