diff --git a/drivers/display/display_st75256.c b/drivers/display/display_st75256.c
new file mode 100644
index 000000000..8255b8217
--- /dev/null
+++ b/drivers/display/display_st75256.c
@@ -0,0 +1,717 @@
+/*
+ * Copyright (c) 2025 MASSDRIVER EI (massdriver.space)
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <zephyr/sys/util.h>
+#define DT_DRV_COMPAT sitronix_st75256
+
+#include <zephyr/logging/log.h>
+LOG_MODULE_REGISTER(st75256, CONFIG_DISPLAY_LOG_LEVEL);
+
+#include <string.h>
+#include <zephyr/device.h>
+#include <zephyr/display/st75256.h>
+#include <zephyr/init.h>
+#include <zephyr/drivers/display.h>
+#include <zephyr/drivers/gpio.h>
+#include <zephyr/drivers/mipi_dbi.h>
+#include <zephyr/kernel.h>
+
+#define ST75256_EXTCOM   0x30
+#define ST75256_EXTCOM_1 ST75256_EXTCOM
+#define ST75256_EXTCOM_2 ST75256_EXTCOM + 1
+#define ST75256_EXTCOM_3 ST75256_EXTCOM + 8
+#define ST75256_EXTCOM_4 ST75256_EXTCOM + 9
+
+/* EXTCOM_1 Commands */
+#define ST75256_DISPLAY_NORMAL 0xa6
+#define ST75256_DISPLAY_INVERT 0xa7
+#define ST75256_DISPLAY_ON     0xaf
+#define ST75256_DISPLAY_OFF    0xae
+#define ST75256_ALL_ON         0x23
+#define ST75256_SLEEP_IN       0x95
+#define ST75256_SLEEP_OUT      0x94
+#define ST75256_SET_START_LINE 0xa3
+#define ST75256_SET_VOP        0x81
+#define ST75256_COL_RANGE      0x15
+#define ST75256_PAGE_RANGE     0x75
+#define ST75256_LSB_BOTTOM     0x8
+#define ST75256_LSB_TOP        0xc
+#define ST75256_FLIP_CONFIG    0xbc
+#define ST75256_DISP_CONTROL   0xca
+#define ST75256_OSC_ON         0xd1
+#define ST75256_VOP_INCREASE   0xd6
+#define ST75256_MULTI_MASTER   0x6E
+#define ST75256_MULTI_SLAVE    0x6F
+#define ST75256_ICON_RAM_OFF   0x76
+#define ST75256_START_WRITE    0x5C
+
+#define ST75256_COLOR_MODE 0xf0
+#define ST75256_GREYSCALE  0x11
+#define ST75256_MONO       0x10
+
+#define ST75256_POWER_CONTROL 0x20
+
+/* EXTCOM_2 Commands */
+#define ST75256_AUTOREAD         0xd7
+#define ST75256_AUTOREAD_ENABLE  0x8f
+#define ST75256_AUTOREAD_DISABLE 0x9f
+#define ST75256_ANALOG_SETTINGS  0x32
+#define ST75256_OTP_READ         0xE3
+#define ST75256_OTP_WRITE        0xE2
+#define ST75256_OTP_OUT          0xE1
+#define ST75256_SET_GREY         0x20
+#define ST75256_POWER_INTERNAL   0x40
+#define ST75256_POWER_EXTERNAL   0x41
+
+#define ST75256_OTP_RW       0xE0
+#define ST75256_OTP_RW_READ  0x00
+#define ST75256_OTP_RW_WRITE 0x20
+
+#define ST75256_BOOSTER_LEVEL    0x51
+#define ST75256_BOOSTER_LEVEL_10 0xFB
+#define ST75256_BOOSTER_LEVEL_8  0xFA
+
+struct st75256_config {
+	const struct device *mipi_dev;
+	struct mipi_dbi_config dbi_config;
+	uint16_t height;
+	uint16_t width;
+	uint8_t booster_frequency;
+	uint8_t bias_ratio;
+	bool lsb_invdir;
+	uint8_t flip_configuration;
+	uint8_t duty;
+	uint8_t fi_settings;
+	uint8_t power_control;
+	uint8_t light_grey;
+	uint8_t dark_grey;
+	bool external_power;
+	bool inversion_on;
+	uint8_t *conversion_buf;
+	size_t conversion_buf_size;
+};
+
+struct st75256_data {
+	enum display_pixel_format current_pixel_format;
+	uint32_t current_screen_info;
+};
+
+static inline bool st75256_is_greyscale_pixel_format(enum display_pixel_format pixel_format)
+{
+	return pixel_format == ST75256_PIXEL_FORMAT_L_8;
+}
+
+static inline bool st75256_is_mono_pixel_format(enum display_pixel_format pixel_format)
+{
+	return pixel_format == PIXEL_FORMAT_MONO01 || pixel_format == PIXEL_FORMAT_MONO10;
+}
+
+static inline uint32_t st75256_mono_screen_info(const struct st75256_config *config)
+{
+	return SCREEN_INFO_MONO_VTILED |
+	       (config->lsb_invdir ? SCREEN_INFO_MONO_MSB_FIRST : 0U);
+}
+
+static inline int st75256_write_command(const struct device *dev, uint8_t cmd, const uint8_t *buf,
+					size_t len)
+{
+	const struct st75256_config *config = dev->config;
+
+	return mipi_dbi_command_write(config->mipi_dev, &config->dbi_config, cmd, buf, len);
+}
+
+static int st75256_configure_greyscale_levels(const struct device *dev)
+{
+	const struct st75256_config *config = dev->config;
+	uint8_t cmd_buf[16];
+
+	cmd_buf[0] = 0;
+	cmd_buf[1] = 0;
+	cmd_buf[2] = 0;
+	cmd_buf[3] = config->light_grey;
+	cmd_buf[4] = config->light_grey;
+	cmd_buf[5] = config->light_grey;
+	cmd_buf[6] = 0;
+	cmd_buf[7] = 0;
+	cmd_buf[8] = config->dark_grey;
+	cmd_buf[9] = 0;
+	cmd_buf[10] = 0;
+	cmd_buf[11] = config->dark_grey;
+	cmd_buf[12] = config->dark_grey;
+	cmd_buf[13] = config->dark_grey;
+	cmd_buf[14] = 0;
+	cmd_buf[15] = 0;
+
+	return st75256_write_command(dev, ST75256_SET_GREY, cmd_buf, sizeof(cmd_buf));
+}
+
+static int st75256_set_mono_display_polarity(const struct device *dev,
+					     enum display_pixel_format pixel_format)
+{
+	if (pixel_format == PIXEL_FORMAT_MONO01) {
+		return st75256_write_command(dev, ST75256_DISPLAY_NORMAL, NULL, 0);
+	}
+
+	if (pixel_format == PIXEL_FORMAT_MONO10) {
+		return st75256_write_command(dev, ST75256_DISPLAY_INVERT, NULL, 0);
+	}
+
+	return -ENOTSUP;
+}
+
+static int st75256_blanking_on(const struct device *dev)
+{
+	int err;
+
+	err = st75256_write_command(dev, ST75256_DISPLAY_OFF, NULL, 0);
+	if (err < 0) {
+		return err;
+	}
+	return st75256_write_command(dev, ST75256_SLEEP_IN, NULL, 0);
+}
+
+static int st75256_blanking_off(const struct device *dev)
+{
+	struct st75256_data *data = dev->data;
+	int err;
+
+	err = st75256_write_command(dev, ST75256_SLEEP_OUT, NULL, 0);
+	if (err < 0) {
+		return err;
+	}
+	/* Wait 10 msec to allow display out of sleep */
+	k_msleep(10);
+
+	err = st75256_write_command(dev, ST75256_OSC_ON, NULL, 0);
+	if (err < 0) {
+		return err;
+	}
+
+	if (st75256_is_mono_pixel_format(data->current_pixel_format)) {
+		err = st75256_set_mono_display_polarity(dev, data->current_pixel_format);
+		if (err < 0) {
+			return err;
+		}
+	}
+
+	return st75256_write_command(dev, ST75256_DISPLAY_ON, NULL, 0);
+}
+
+static int st75256_set_window(const struct device *dev, int x, int y, int width, int height)
+{
+	struct st75256_data *data = dev->data;
+	int ret;
+	uint8_t x_position[] = {x, x + width - 1};
+	uint8_t y_position[2];
+	int page_height = st75256_is_greyscale_pixel_format(data->current_pixel_format) ? 4 : 8;
+
+	y_position[0] = y / page_height;
+	y_position[1] = (y + height - 1) / page_height;
+
+	ret = st75256_write_command(dev, ST75256_PAGE_RANGE, y_position, 2);
+	if (ret < 0) {
+		return ret;
+	}
+
+	return st75256_write_command(dev, ST75256_COL_RANGE, x_position, 2);
+}
+
+static int st75256_start_write(const struct device *dev)
+{
+	return st75256_write_command(dev, ST75256_START_WRITE, NULL, 0);
+}
+
+static int st75256_clear_ddram(const struct device *dev)
+{
+	const struct st75256_config *config = dev->config;
+	struct st75256_data *data = dev->data;
+	struct display_buffer_descriptor mipi_desc = {0};
+	uint16_t page_height;
+	uint16_t clear_chunk_width;
+	uint8_t clear_byte = 0x00;
+	int ret = 0;
+	int release_ret;
+
+	/* ST75256 keeps DDRAM contents across reset, so clear it before DISPLAY_ON. */
+	page_height = st75256_is_greyscale_pixel_format(data->current_pixel_format) ? 4 : 8;
+	clear_chunk_width = MIN(config->width, (uint16_t)config->conversion_buf_size);
+	if (clear_chunk_width == 0U) {
+		return -ENOMEM;
+	}
+
+	if (data->current_pixel_format == PIXEL_FORMAT_MONO01) {
+		clear_byte = 0xFF;
+	}
+
+	memset(config->conversion_buf, clear_byte, clear_chunk_width);
+
+	for (uint16_t page_y = 0; page_y < config->height; page_y += page_height) {
+		for (uint16_t x = 0; x < config->width; x += clear_chunk_width) {
+			uint16_t chunk_width = MIN(clear_chunk_width,
+						   (uint16_t)(config->width - x));
+
+			mipi_desc.buf_size = chunk_width;
+			mipi_desc.width = chunk_width;
+			mipi_desc.height = page_height;
+			mipi_desc.pitch = chunk_width;
+
+			ret = st75256_set_window(dev, x, page_y, chunk_width, page_height);
+			if (ret < 0) {
+				goto out;
+			}
+
+			ret = st75256_start_write(dev);
+			if (ret < 0) {
+				goto out;
+			}
+
+			ret = mipi_dbi_write_display(config->mipi_dev, &config->dbi_config,
+						     config->conversion_buf, &mipi_desc,
+						     data->current_pixel_format);
+			if (ret < 0) {
+				goto out;
+			}
+		}
+	}
+
+out:
+	release_ret = mipi_dbi_release(config->mipi_dev, &config->dbi_config);
+	if (ret < 0) {
+		return ret;
+	}
+
+	return release_ret;
+}
+
+static int st75256_write_pixels_MONO01(const struct device *dev, const uint16_t x, const uint16_t y,
+				       const uint8_t *buf,
+				       const struct display_buffer_descriptor *desc)
+{
+	const struct st75256_config *config = dev->config;
+	struct display_buffer_descriptor mipi_desc = {
+		.buf_size = desc->width,
+		.width = desc->width,
+		.height = 8,
+		.pitch = desc->width,
+		.frame_incomplete = desc->frame_incomplete,
+	};
+	int ret;
+	const uint8_t *page_buf = buf;
+
+	for (int i = 0; i < desc->height / 8; i++) {
+		ret = st75256_set_window(dev, x, y + i * 8, desc->width, 8);
+		if (ret < 0) {
+			return ret;
+		}
+
+		ret = st75256_start_write(dev);
+		if (ret < 0) {
+			return ret;
+		}
+
+		ret = mipi_dbi_write_display(config->mipi_dev, &config->dbi_config, page_buf,
+					     &mipi_desc,
+					     PIXEL_FORMAT_MONO01);
+		if (ret < 0) {
+			return ret;
+		}
+
+		page_buf += desc->width;
+	}
+
+	return mipi_dbi_release(config->mipi_dev, &config->dbi_config);
+}
+
+/* ST75256 4-level is greyscale is 4 pixels per byte vtiled.
+ * It also does not have windowing capability so we do one line per one line.
+ */
+static int st75256_write_pixels_L_8(const struct device *dev, const uint16_t x, const uint16_t y,
+				    const uint8_t *buf,
+				    const struct display_buffer_descriptor *desc)
+{
+	const struct st75256_config *config = dev->config;
+	struct display_buffer_descriptor mipi_desc;
+	int32_t line_count = desc->height;
+	int ret, l;
+	int line_total = 0;
+
+	mipi_desc.pitch = desc->pitch;
+
+	ret = st75256_set_window(dev, x, y, desc->width, desc->height);
+	if (ret < 0) {
+		return ret;
+	}
+
+	ret = st75256_start_write(dev);
+	if (ret < 0) {
+		return ret;
+	}
+
+	while (line_count > line_total) {
+		l = 0;
+
+		/* Convert what the conversion buffer can hold to
+		 * pixelx[7:6], pixelx+pitch[5:4], pixelx+2pitch[3:2], pixelx+3pitch[1:0]
+		 */
+		for (; l * desc->width / 4 < config->conversion_buf_size &&
+		       line_count > line_total + l;
+		     l += 4) {
+			int i_lt = line_total + l;
+
+			for (int i = 0; i < desc->width &&
+					i + l * desc->width / 4 < config->conversion_buf_size;
+			     i++) {
+				int i_l = i + l * desc->width / 4;
+
+				config->conversion_buf[i_l] =
+					((buf[i + (i_lt + 0) * desc->pitch] >> 6) << 0) |
+					((buf[i + (i_lt + 1) * desc->pitch] >> 6) << 2) |
+					((buf[i + (i_lt + 2) * desc->pitch] >> 6) << 4) |
+					((buf[i + (i_lt + 3) * desc->pitch] >> 6) << 6);
+			}
+		}
+		mipi_desc.buf_size = l * desc->width / 4;
+		mipi_desc.width = desc->width;
+		mipi_desc.height = l;
+
+		/* This is the wrong format, but it doesn't matter to almost all mipi drivers */
+		ret = mipi_dbi_write_display(config->mipi_dev, &config->dbi_config,
+					     config->conversion_buf, &mipi_desc,
+					     ST75256_PIXEL_FORMAT_L_8);
+		if (ret < 0) {
+			return ret;
+		}
+		line_total += l;
+	}
+
+	return mipi_dbi_release(config->mipi_dev, &config->dbi_config);
+}
+
+static int st75256_write(const struct device *dev, const uint16_t x, const uint16_t y,
+			 const struct display_buffer_descriptor *desc, const void *buf)
+{
+	struct st75256_data *data = dev->data;
+	size_t buf_len;
+
+	/* pitch is always width because of vtiled monochrome at 8 pixels per byte
+	 * or greyscale at one pixel per byte converted to vtiled 4 pixels per byte
+	 */
+	if (desc->pitch != desc->width) {
+		LOG_ERR("Pitch is not width");
+		return -EINVAL;
+	}
+
+	if (st75256_is_mono_pixel_format(data->current_pixel_format)) {
+		buf_len = desc->height * desc->width / 8;
+		if ((y % 8) != 0 || (desc->height % 8) != 0) {
+			LOG_ERR("Y and height must be aligned on 8 boundary");
+			return -EINVAL;
+		}
+	} else if (st75256_is_greyscale_pixel_format(data->current_pixel_format)) {
+		buf_len = desc->height * desc->width;
+		if ((y % 4) != 0 || (desc->height % 4) != 0) {
+			LOG_ERR("Y and height must be aligned on 4 boundary");
+			return -EINVAL;
+		}
+	} else {
+		return -ENOTSUP;
+	}
+
+	if (buf == NULL || buf_len == 0U) {
+		LOG_ERR("Display buffer is not available");
+		return -EINVAL;
+	}
+
+	if (desc->buf_size < buf_len) {
+		LOG_ERR("Display buffer is too small");
+		return -EINVAL;
+	}
+
+	LOG_DBG("x %u, y %u, pitch %u, width %u, height %u, buf_len %u", x, y, desc->pitch,
+		desc->width, desc->height, buf_len);
+
+	if (st75256_is_greyscale_pixel_format(data->current_pixel_format)) {
+		return st75256_write_pixels_L_8(dev, x, y, buf, desc);
+	} else {
+		return st75256_write_pixels_MONO01(dev, x, y, buf, desc);
+	}
+}
+
+static int st75256_set_contrast(const struct device *dev, const uint8_t contrast)
+{
+	uint8_t contrast_out[2];
+
+	contrast_out[0] = (contrast & 0x1f) << 1;
+	contrast_out[1] = contrast >> 5;
+	return st75256_write_command(dev, ST75256_SET_VOP, contrast_out, sizeof(contrast_out));
+}
+
+static void st75256_get_capabilities(const struct device *dev, struct display_capabilities *caps)
+{
+	const struct st75256_config *config = dev->config;
+	struct st75256_data *data = dev->data;
+
+	memset(caps, 0, sizeof(struct display_capabilities));
+	caps->x_resolution = config->width;
+	caps->y_resolution = config->height;
+	caps->supported_pixel_formats =
+		PIXEL_FORMAT_MONO01 | PIXEL_FORMAT_MONO10 | ST75256_PIXEL_FORMAT_L_8;
+	caps->current_pixel_format = data->current_pixel_format;
+	caps->screen_info = data->current_screen_info;
+	caps->current_orientation = DISPLAY_ORIENTATION_NORMAL;
+}
+
+static int st75256_set_pixel_format(const struct device *dev,
+				    const enum display_pixel_format pixel_format)
+{
+	struct st75256_data *data = dev->data;
+	const struct st75256_config *config = dev->config;
+	uint8_t tmp;
+	int ret;
+
+	if (st75256_is_mono_pixel_format(pixel_format)) {
+		tmp = ST75256_MONO;
+		ret = st75256_write_command(dev, ST75256_COLOR_MODE, &tmp, 1);
+		if (ret < 0) {
+			return ret;
+		}
+
+		ret = st75256_set_mono_display_polarity(dev, pixel_format);
+		if (ret < 0) {
+			return ret;
+		}
+
+		data->current_screen_info = st75256_mono_screen_info(config);
+		data->current_pixel_format = pixel_format;
+	} else if (st75256_is_greyscale_pixel_format(pixel_format)) {
+		ret = st75256_configure_greyscale_levels(dev);
+		if (ret < 0) {
+			return ret;
+		}
+
+		tmp = ST75256_GREYSCALE;
+		ret = st75256_write_command(dev, ST75256_COLOR_MODE, &tmp, 1);
+		if (ret < 0) {
+			return ret;
+		}
+
+		ret = st75256_write_command(
+			dev, config->inversion_on ? ST75256_DISPLAY_INVERT : ST75256_DISPLAY_NORMAL,
+			NULL, 0);
+		if (ret < 0) {
+			return ret;
+		}
+
+		data->current_screen_info = 0;
+		data->current_pixel_format = ST75256_PIXEL_FORMAT_L_8;
+	} else {
+		LOG_ERR("Unsupported Pixel format");
+		return -ENOTSUP;
+	}
+	return 0;
+}
+
+static int st75256_init_device(const struct device *dev)
+{
+	int ret;
+	uint8_t cmd_buf[3];
+	const struct st75256_config *config = dev->config;
+	struct st75256_data *disp_data = dev->data;
+
+	ret = mipi_dbi_reset(config->mipi_dev, 20);
+	if (ret < 0) {
+		return ret;
+	}
+	k_msleep(20);
+
+#if CONFIG_ST75256_DEFAULT_GREYSCALE
+	disp_data->current_screen_info = 0;
+	disp_data->current_pixel_format = ST75256_PIXEL_FORMAT_L_8;
+#else
+	disp_data->current_screen_info = st75256_mono_screen_info(config);
+	disp_data->current_pixel_format =
+		config->inversion_on ? PIXEL_FORMAT_MONO10 : PIXEL_FORMAT_MONO01;
+#endif
+
+	cmd_buf[0] = 0;
+	cmd_buf[1] = config->duty;
+	cmd_buf[2] = config->fi_settings;
+	ret = st75256_write_command(dev, ST75256_DISP_CONTROL, cmd_buf, sizeof(cmd_buf));
+	if (ret < 0) {
+		return ret;
+	}
+
+	ret = st75256_write_command(dev, ST75256_SLEEP_OUT, NULL, 0);
+	if (ret < 0) {
+		return ret;
+	}
+	k_msleep(10);
+
+	cmd_buf[0] = config->flip_configuration;
+	ret = st75256_write_command(dev, ST75256_FLIP_CONFIG, cmd_buf, 1);
+	if (ret < 0) {
+		return ret;
+	}
+
+	cmd_buf[0] = 0;
+	ret = st75256_write_command(dev, ST75256_SET_START_LINE, cmd_buf, 1);
+	if (ret < 0) {
+		return ret;
+	}
+
+	ret = st75256_write_command(dev, ST75256_OSC_ON, NULL, 0);
+	if (ret < 0) {
+		return ret;
+	}
+
+	ret = st75256_write_command(dev, ST75256_POWER_CONTROL, &config->power_control, 1);
+	if (ret < 0) {
+		return ret;
+	}
+
+	ret = st75256_set_contrast(dev, CONFIG_ST75256_DEFAULT_CONTRAST);
+	if (ret < 0) {
+		return ret;
+	}
+
+	ret = st75256_write_command(dev, ST75256_VOP_INCREASE, NULL, 0);
+	if (ret < 0) {
+		return ret;
+	}
+
+	ret = st75256_write_command(dev, config->lsb_invdir ? ST75256_LSB_BOTTOM : ST75256_LSB_TOP,
+				    NULL, 0);
+	if (ret < 0) {
+		return ret;
+	}
+
+	cmd_buf[0] = 0;
+	cmd_buf[1] = config->booster_frequency;
+	cmd_buf[2] = config->bias_ratio;
+	ret = st75256_write_command(dev, ST75256_ANALOG_SETTINGS, cmd_buf, sizeof(cmd_buf));
+	if (ret < 0) {
+		return ret;
+	}
+
+	cmd_buf[0] = ST75256_BOOSTER_LEVEL_10;
+	ret = st75256_write_command(dev, ST75256_BOOSTER_LEVEL, cmd_buf, 1);
+	if (ret < 0) {
+		return ret;
+	}
+
+	ret = st75256_write_command(
+		dev, config->external_power ? ST75256_POWER_EXTERNAL : ST75256_POWER_INTERNAL, NULL,
+		0);
+	if (ret < 0) {
+		return ret;
+	}
+
+	ret = st75256_write_command(dev, ST75256_MULTI_MASTER, NULL, 0);
+	if (ret < 0) {
+		return ret;
+	}
+
+	ret = st75256_write_command(dev, ST75256_ICON_RAM_OFF, NULL, 0);
+	if (ret < 0) {
+		return ret;
+	}
+
+	ret = st75256_set_pixel_format(dev, disp_data->current_pixel_format);
+	if (ret < 0) {
+		return ret;
+	}
+
+	ret = st75256_clear_ddram(dev);
+	if (ret < 0) {
+		return ret;
+	}
+
+	return st75256_write_command(dev, ST75256_DISPLAY_ON, NULL, 0);
+}
+
+static int st75256_init(const struct device *dev)
+{
+	const struct st75256_config *config = dev->config;
+	int ret;
+
+	if (!device_is_ready(config->mipi_dev)) {
+		LOG_ERR("MIPI not ready!");
+		return -ENODEV;
+	}
+
+	ret = st75256_init_device(dev);
+	if (ret < 0) {
+		LOG_ERR("Failed to initialize device, err = %d", ret);
+	}
+
+	return ret;
+}
+
+static DEVICE_API(display, st75256_driver_api) = {
+	.blanking_on = st75256_blanking_on,
+	.blanking_off = st75256_blanking_off,
+	.write = st75256_write,
+	.set_contrast = st75256_set_contrast,
+	.get_capabilities = st75256_get_capabilities,
+	.set_pixel_format = st75256_set_pixel_format,
+};
+
+#define ST75256_WORD_SIZE(inst)                                                                    \
+	((DT_STRING_UPPER_TOKEN_OR(inst, mipi_mode, MIPI_DBI_MODE_SPI_4WIRE) ==                    \
+	  MIPI_DBI_MODE_SPI_4WIRE) ? SPI_WORD_SET(8) : SPI_WORD_SET(9))
+
+#define ST75256_CONV_BUFFER_SIZE(node_id)                                                          \
+	(DT_PROP(node_id, width) * DIV_ROUND_UP(CONFIG_ST75256_CONV_BUFFER_LINES, 4))
+
+#if CONFIG_ST75256_DEFAULT_GREYSCALE
+#define ST75256_DATA(node_id)                                                                      \
+	static struct st75256_data data##node_id = {                                               \
+		.current_pixel_format = ST75256_PIXEL_FORMAT_L_8,                                 \
+		.current_screen_info = 0,                                                          \
+	};
+#else
+#define ST75256_DATA(node_id)                                                                      \
+	static struct st75256_data data##node_id = {                                               \
+		.current_pixel_format = DT_PROP(node_id, inversion_on) ? PIXEL_FORMAT_MONO10 :    \
+					       PIXEL_FORMAT_MONO01,                         \
+		.current_screen_info = SCREEN_INFO_MONO_VTILED |                                  \
+				       (DT_PROP(node_id, lsb_invdir) ?                         \
+						SCREEN_INFO_MONO_MSB_FIRST : 0),          \
+	};
+#endif
+
+#define ST75256_DEFINE(node_id)                                                                    \
+	ST75256_DATA(node_id)                                                                      \
+	static uint8_t conversion_buf##node_id[ST75256_CONV_BUFFER_SIZE(node_id)];                 \
+	static const struct st75256_config config##node_id = {                                     \
+		.height = DT_PROP(node_id, height),                                                \
+		.width = DT_PROP(node_id, width),                                                  \
+		.booster_frequency = DT_PROP(node_id, booster_frequency),                          \
+		.bias_ratio = DT_PROP(node_id, bias_ratio),                                        \
+		.lsb_invdir = DT_PROP(node_id, lsb_invdir),                                        \
+		.flip_configuration = DT_PROP(node_id, flip_configuration),                        \
+		.duty = DT_PROP(node_id, duty),                                                    \
+		.power_control = DT_PROP(node_id, power_control),                                  \
+		.light_grey = DT_PROP(node_id, light_grey),                                        \
+		.dark_grey = DT_PROP(node_id, dark_grey),                                          \
+		.external_power = DT_PROP(node_id, external_power),                                \
+		.fi_settings = DT_PROP(node_id, fi_settings),                                      \
+		.inversion_on = DT_PROP(node_id, inversion_on),                                    \
+		.mipi_dev = DEVICE_DT_GET(DT_PARENT(node_id)),                                     \
+		.dbi_config = {                                                                   \
+			.mode = DT_STRING_UPPER_TOKEN_OR(                                          \
+				node_id, mipi_mode, MIPI_DBI_MODE_SPI_4WIRE),                      \
+			.config = MIPI_DBI_SPI_CONFIG_DT(                                         \
+				node_id, ST75256_WORD_SIZE(node_id) | SPI_OP_MODE_MASTER, 0),      \
+		},                                                                               \
+		.conversion_buf = conversion_buf##node_id,                                         \
+		.conversion_buf_size = sizeof(conversion_buf##node_id),                            \
+	};                                                                                         \
+                                                                                                   \
+	DEVICE_DT_DEFINE(node_id, st75256_init, NULL, &data##node_id, &config##node_id,            \
+			 POST_KERNEL, CONFIG_DISPLAY_INIT_PRIORITY, &st75256_driver_api);
+
+DT_FOREACH_STATUS_OKAY(sitronix_st75256, ST75256_DEFINE)
