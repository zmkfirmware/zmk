 #include <behaviors.dtsi>
 #include <dt-bindings/zmk/keys.h>
 //#include <dt-bindings/zmk/rgb.h>
 #include <dt-bindings/zmk/bt.h>
 #include <dt-bindings/zmk/outputs.h>
 
 / {
	 keymap {
		 compatible = "zmk,keymap";
		 
		 default_layer {
 // -----------------------------------------------------------------------------------------------------------------------------
 // |   ESC  |   1   |   2   |    3   |    4   |    5   |    6   |    7   |    8   |    9   |    0   |    -   |    +   |   BS   |
 // |   TAB  |   Q   |   W   |    E   |    R   |    T   |    Y   |    U   |    I   |    O   |    P   |    [   |    ]   |    \   |
 // |  CAPS  |   A   |   S   |    D   |    F   |    G   |    H   |    J   |    K   |    L   |    ;   |    '   |        |   ENT  |
 // |   STF  |   Z   |   X   |    C   |    V   |    B   |    N   |    M   |    ,   |    .   |    /   |   SFT  |    up  |    ~   |
 // |   CTL  |  OPT  |  CMD  |        |   sp   |        |        |   sp   |        |   CMD  |  MO(1) |  left  |   down |  right |
 // -----------------------------------------------------------------------------------------------------------------------------
			 bindings = < 
	 &kp ESC &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6  &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL &kp BSPC 
	 &kp TAB &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp LBKT &kp RBKT &kp BSLH 
	 &kp CAPSLOCK &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp SEMI &kp SQT &kp ENTER 
	 &kp LSHFT &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp PERIOD &kp FSLH &kp RSHFT &kp UP &kp GRAVE 
	 &kp LCTRL &kp LALT &kp LGUI &kp SPACE &kp SPACE &kp RGUI &mo 1  &kp LEFT &kp DOWN &kp RIGHT
			 >;
		 };
 
		 func_layer {
 // -----------------------------------------------------------------------------------------------------------------------------
 // |   ESC  |  F1   |  F2   |   F3   |   F4   |   F5   |   F6   |   F7   |   F8   |   F9   |   F10  |   F11  |   F12  |   DEL  |
 // |   TAB  |  BT 0 |  BT 1 |  BT 2  |  BT 3  |  BT 4  | BT CLR |  calc  |   ins  |printscr|scrolloc|pausebre|        |        |
 // |  CAPS  |       |       |        |        |appplay |pretrack|nxttrack|        |        |  home  | pageup |  ----- |   ENT  |
 // |   STF  |       |  app  |        |        |        |volumedn|volumeup|  mute  |   end  |pagedown|   SFT  |    up  |    ~   |
 // |   CTL  |  OPT  |  CMD  |  ----  |   sp   |  ----  |  ----- |   sp   |  ----- |   CMD  |  MO(1) |  left  |   down |  right |
 // -----------------------------------------------------------------------------------------------------------------------------
			 bindings = <
	 &kp ESC &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6  &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12 &kp DEL 
	 &kp TAB &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_CLR &kp C_AL_CALC &kp INS &kp PSCRN &kp SLCK &kp PAUSE_BREAK  &trans &trans 
	 &kp CAPSLOCK &trans &trans &trans &trans &kp C_PP &kp C_PREV &kp C_NEXT &trans &trans &kp HOME &kp PG_UP &kp ENTER 
	 &kp LSHFT &trans &trans &trans &trans &trans &kp C_VOL_DN &kp C_VOL_UP &kp K_MUTE &kp END &kp PG_DN &kp RSHFT &kp UP &kp GRAVE 
	 &kp LCTRL &kp LALT &kp LGUI &kp SPACE &kp SPACE &kp RGUI &trans  &kp LEFT &kp DOWN &kp RIGHT 
			 >;
		 };
 
	 };
 };
 