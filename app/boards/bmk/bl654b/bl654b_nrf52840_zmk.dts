/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/ext_power.h>
#include <common/nordic/nrf52840_uf2_boot_mode.dtsi>

#include "bl654b-pinctrl.dtsi"
#include "bl654b_layouts.dtsi"

/ {
	model = "bl654b";
	compatible = "bmk,bl654b";

	chosen {
		zephyr,code-partition = &code_partition;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zmk,kscan = &kscan0;
		//zmk,matrix_transform = &default_transform;
		//zmk,backlight = &backlight;
		//zmk,underglow = &led_strip;
		zmk,battery = &vbatt;
		//zephyr,display = &st7789;
		zephyr,display = &nice_view;
		//zmk,physical-layout = &layout_bl654b;
	};

	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <4>;
		rows = <5>;
		map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) 
RC(1,0) RC(1,1) RC(1,2) RC(1,3) 
RC(2,0) RC(2,1) RC(2,2) RC(2,3)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) 
RC(4,0) RC(4,1) RC(4,2) RC(4,3)
		>;
	};

	kscan0: kscan {
		compatible = "zmk,kscan-gpio-matrix";
		diode-direction = "row2col";
		wakeup-source;
		row-gpios
			= <&gpio1 2 GPIO_ACTIVE_HIGH>
			, <&gpio1 4 GPIO_ACTIVE_HIGH>
			, <&gpio1 6 GPIO_ACTIVE_HIGH>
			, <&gpio0 9 GPIO_ACTIVE_HIGH>
			, <&gpio0 10 GPIO_ACTIVE_HIGH>
			;
		col-gpios
			= <&gpio0 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			;
	};

	
/*
	backlight: pwmleds {
		compatible = "pwm-leds";
		pwm_led_0 {
			pwms = <&pwm0 0 PWM_MSEC(10) PWM_POLARITY_NORMAL>;
		}; 
};

*/

	vbatt: vbatt {
		compatible = "zmk,battery-nrf-vddh";
	};
};

