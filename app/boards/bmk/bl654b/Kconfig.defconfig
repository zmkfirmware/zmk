if BOARD_BL654B

config ZMK_KEYBOARD_NAME
	default "bl654b"

if USB_DEVICE_STACK

config USB_NRFX
    default y

endif # USB_DEVICE_STACK

config BT_CTLR
	default BT

if DISPLAY
    
config SPI
    default y

if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # LVG
endif # DISPLAY

endif # BOARD_BL654B
