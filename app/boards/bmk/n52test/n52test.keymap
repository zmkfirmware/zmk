#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/input_speed.h>
#include <dt-bindings/zmk/led_matrix.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                &kp KP_NLCK  &kp DEL        &kp BSPC         &kp KP_DIVIDE
                &kp KP_N7    &kp KP_N8      &kp KP_N9        &kp KP_MULTIPLY
                &kp KP_N4    &kp KP_N5      &kp KP_N6        &kp KP_MINUS
                &kp KP_N1    &kp KP_N2      &kp KP_N3        &kp KP_PLUS
                &mo 2        &kp KP_N0      &kp KP_DOT       &kp KP_ENTER
                &lm LM_CFF 0
            >;
        };

        media_layer {
            display-name = "Media";
            bindings = <
                &kp KP_NLCK  &none          &none            &kp C_MUTE
                &none        &kp C_BRI_UP    &kp C_EJECT      &kp C_VOL_DN
                &kp C_PREV   &kp C_PLAY      &kp C_NEXT       &kp C_VOL_UP
                &none        &kp C_BRI_DN    &kp C_STOP       &none
                &mo 2        &none           &none            &kp KP_ENTER
                &lm LM_CFF 0
            >;
        };

        func_layer {
            display-name = "Fn";
            bindings = <
                &tbspd INPUT_SPEED_DOWN
                              &tbspd INPUT_SPEED_UP
                                            &bt BT_CLR       &lm LM_STA LM_STA_ALL
                &lm LM_SPI    &lm LM_BRI    &lm LM_HUI      &lm LM_TOG
                &lm LM_SPD    &lm LM_BRD    &lm LM_HUD      &lm LM_EFF
                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_SEL 3
                &mo 2         &none         &none            &tog 1
                &lm LM_CFF 0
            >;
        };
    };
};
