interface Props {
  value: boolean | null | undefined;
}

const { value } = Astro.props;
---

{value === true ? (
  <span class="supported" title="Supported 😄">
    ⭐
  </span>
) : value === false ? (
  <span class="not-supported" title="Not Supported 😢">
    ❌
  </span>
) : (
  <span class="not-tested" title="Not Tested Yet - PR's welcomed! 🧐">
    ❔
  </span>
)}
