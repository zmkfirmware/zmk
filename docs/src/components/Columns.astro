---
import type { HTMLAttributes } from "astro/types";

interface Props {
  className?: string;
  style?: HTMLAttributes<"div">["style"];
}

const { className, style } = Astro.props;
---

<div class:list={["columns", className]} style={style}>
  <slot />
</div>

<style>
  /* Simple replacement for the Infima row/col layout used by the old site. */
  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1rem;
    align-items: start;
    margin-block: 1rem;
  }
</style>
