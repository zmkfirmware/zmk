---
// Based on @astrojs/starlight 0.42.8 "components/PageTitle.astro".
// ZMK change: a larger, heavier page title. The band spacing and divider are
// handled in src/styles/site.css.
// Re-diff against upstream when upgrading Starlight.
const { title } = Astro.locals.starlightRoute.entry.data;
---

<h1 id="_top">{title}</h1>

<style>
  @layer starlight.core {
    h1 {
      margin-top: 0;
      font-size: 2rem;
      line-height: var(--sl-line-height-headings);
      font-weight: 700;
      color: var(--sl-color-white);
    }

    @media (min-width: 50rem) {
      h1 {
        font-size: 2.5rem;
      }
    }
  }
</style>
