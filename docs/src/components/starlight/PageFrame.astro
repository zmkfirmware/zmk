---
// Based on @astrojs/starlight 0.42.8 "components/PageFrame.astro".
import MobileMenuFooter from "@astrojs/starlight/components/MobileMenuFooter.astro";
import MobileMenuToggle from "@astrojs/starlight/components/MobileMenuToggle.astro";

import { normalizePathname } from "../../lib/nav";
import SiteMenu from "./SiteMenu.astro";

const { hasSidebar } = Astro.locals.starlightRoute;
const pathname = normalizePathname(Astro.url.pathname);
---

<div class="page sl-flex">
  <header class="header">
    <slot name="header" />
  </header>
  <nav
    class:list={["sidebar", "print:hidden", { "no-sidebar": !hasSidebar }]}
    aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}
  >
    <MobileMenuToggle />
    <script>
      // The mobile menu uses the popover API to open and close without JavaScript. We enhance this
      // behaviour with focus trapping while the menu is open.
      class StarlightSidebarPane extends HTMLElement {
        constructor() {
          super();

          const desktopMediaQuery = matchMedia("(min-width: 50em)");

          // Remove the popover attribute on desktop viewports. It's only needed for the mobile menu.
          const resetPopoverAttribute = () => {
            this.popover = desktopMediaQuery.matches ? null : "auto";
          };
          resetPopoverAttribute();
          desktopMediaQuery.addEventListener("change", () =>
            resetPopoverAttribute()
          );

          // Update the menu state when the sidebar popover is toggled.
          this.addEventListener("toggle", ({ newState }) =>
            this.trapFocus(newState === "open")
          );
        }
        /** Trap keyboard focus inside the header and menu when the menu is expanded. */
        trapFocus(shouldTrap: boolean) {
          document
            .querySelectorAll<HTMLElement>(".main-frame, .sl-skip-link")
            .forEach((el) => {
              el.toggleAttribute("inert", shouldTrap);
            });
          // The drawer has its own close button, so the header is not needed while it is open.
          document
            .querySelector<HTMLElement>(".page > .header")
            ?.toggleAttribute("inert", shouldTrap);
        }
      }
      customElements.define("sl-sidebar-pane", StarlightSidebarPane);
    </script>
    <sl-sidebar-pane popover="" id="starlight__sidebar" class="sidebar-pane">
      <div class="sidebar-content sl-flex">
        <SiteMenu pathname={pathname} defaultExpanded={!hasSidebar} />
        <slot name="sidebar" />
        {!hasSidebar && <MobileMenuFooter />}
      </div>
    </sl-sidebar-pane>
  </nav>
  <div class="main-frame">
    <slot />
  </div>
</div>

<style>
  @layer starlight.core {
    .page {
      flex-direction: column;
      min-height: 100vh;
    }

    .header {
      z-index: var(--sl-z-index-navbar);
      position: fixed;
      inset-inline-start: 0;
      inset-block-start: 0;
      width: 100%;
      height: var(--sl-nav-height);
      border-bottom: 1px solid var(--sl-color-hairline-shade);
      padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
      background-color: var(--sl-color-bg-nav);
    }

    /* Every route now has the drawer toggle, so every route reserves space for it. */
    @media (width < 50rem) {
      .header {
        padding-inline-end: calc(
          var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size)
        );
      }
    }

    .sidebar-pane {
      /* By default, user agents apply some opinionated styles to popovers, which we don't want. */
      border: unset;
      padding: unset;
      height: unset;
      color: unset;

      position: fixed;
      z-index: var(--sl-z-index-menu);
      inset-block: var(--sl-nav-height) 0;
      inset-inline-start: 0;
      width: 100%;
      background-color: var(--sl-color-black);
      overflow-y: auto;
      scrollbar-gutter: stable;
    }

    .sidebar-content {
      height: 100%;
      min-height: max-content;
      padding: 1rem var(--sl-sidebar-pad-x) 0;
      flex-direction: column;
      gap: 1rem;
    }

    @media (min-width: 50rem) {
      .sidebar-content::after {
        content: "";
        padding-bottom: 1px;
      }
    }

    .main-frame {
      padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
      padding-inline-start: var(--sl-content-inline-start);
    }

    @media (min-width: 50rem) {
      /* Routes without a docs sidebar still need the drawer below 50rem, but no
       * column or empty landmark above it. */
      .sidebar.no-sidebar {
        display: none;
      }

      .sidebar-pane {
        /* Make the sidebar visible on larger screens instead of deferring to popover state. */
        display: block;
        width: var(--sl-sidebar-width);
        background-color: var(--sl-color-bg-sidebar);
        border-inline-end: 1px solid var(--sl-color-hairline-shade);
      }
    }
  }
</style>
