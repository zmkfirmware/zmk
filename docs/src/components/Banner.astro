---
import { isDevelopmentVersion, releaseVersions } from "../lib/versions.mjs";

const { banner } = Astro.locals.starlightRoute.entry.data;
const routeId = Astro.locals.starlightRoute.id;
const latestVersion = releaseVersions[0];
const showDevBanner =
  isDevelopmentVersion && (routeId === "docs" || routeId.startsWith("docs/"));
---

{showDevBanner && (
  <div class="sl-banner" role="alert" data-pagefind-ignore>
    You&apos;re viewing the documentation for the development version of ZMK.
    You may want the latest release{" "}
    <a
      href={`https://v${latestVersion.replaceAll(".", "-")}-branch.zmk.dev/docs/`}
    >
      v{latestVersion}
    </a>
    .
  </div>
)}
{banner && (
  <div class="sl-banner" data-pagefind-ignore set:html={banner.content} />
)}

<style>
  @layer starlight.core {
    .sl-banner {
      --__sl-banner-text: var(
        --sl-color-banner-text,
        var(--sl-color-text-invert)
      );
      padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
      background-color: var(--sl-color-banner-bg, var(--sl-color-bg-accent));
      color: var(--__sl-banner-text);
      line-height: var(--sl-line-height-headings);
      text-align: center;
      text-wrap: balance;
      box-shadow: var(--sl-shadow-sm);
    }
    .sl-banner :global(a) {
      color: var(--__sl-banner-text);
    }
  }
</style>
