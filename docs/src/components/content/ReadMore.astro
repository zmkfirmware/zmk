import { Icon } from "@astrojs/starlight/components";

interface Props {
  className?: string;
}

const { className } = Astro.props;
---

<aside class:list={["read-more", className]} aria-label="Read more">
  <span class="icon" aria-hidden="true">
    <Icon name="open-book" />
  </span>
  <div class="content">
    <slot />
  </div>
</aside>

<style>
  .read-more {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    margin-block: 0.5rem 0.8rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
  }

  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    flex: 0 0 1.5rem;
    margin-top: 0.1rem;
    color: var(--sl-color-gray-3);
  }

  .icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .content {
    min-width: 0;
    flex: 1 1 auto;
  }

  .content > :global(:first-child) {
    margin-top: 0;
  }

  .content > :global(:last-child) {
    margin-bottom: 0;
  }
</style>
