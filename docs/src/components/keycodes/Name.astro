interface Props {
  name: string;
}

const { name } = Astro.props;
---

<code
  class="name"
  data-copy={name}
  title="Copy 📋"
  role="button"
  tabindex="0"
  aria-label={`Copy ${name}`}
>
  {name}
</code>
