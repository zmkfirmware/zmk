import FootnoteRefs from "./FootnoteRefs.astro";
import OsSupportIcon from "./OsSupportIcon.astro";

interface FootnoteItem {
  id: string;
  anchor: string;
  symbol: number | string;
}

interface Props {
  value: boolean | null | undefined;
  footnotes?: FootnoteItem[];
}

const { value, footnotes = [] } = Astro.props;
---

<OsSupportIcon value={value} />
{footnotes.length > 0 && <FootnoteRefs footnotes={footnotes} />}
