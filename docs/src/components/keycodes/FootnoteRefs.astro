interface FootnoteItem {
  id: string;
  anchor: string;
  symbol: number | string;
}

interface Props {
  footnotes: FootnoteItem[];
}

const { footnotes } = Astro.props;
---

<span class="footnoteRefs">
  {footnotes.map((footnote, index) => (
    <Fragment>
      {index > 0 && ", "}
      <a href={`#${footnote.anchor}`} class="footnoteRef">
        {footnote.symbol}
      </a>
    </Fragment>
  ))}
</span>
