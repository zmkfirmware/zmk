---
interface Props {
  className?: string;
}

const { className } = Astro.props;
---

<aside class:list={["read-more", className]}>
  <span class="icon" aria-hidden="true">
    <svg viewBox="0 0 448 512" fill="currentColor" focusable="false">
      <path d="M96 0C43 0 0 43 0 96V416c0 53 43 96 96 96H384h32c17.7 0 32-14.3 32-32s-14.3-32-32-32V384c17.7 0 32-14.3 32-32V32c0-17.7-14.3-32-32-32H384 96zm0 384H352v64H96c-17.7 0-32-14.3-32-32s14.3-32 32-32zm32-240c0-8.8 7.2-16 16-16H336c8.8 0 16 7.2 16 16s-7.2 16-16 16H144c-8.8 0-16-7.2-16-16zm16 48H336c8.8 0 16 7.2 16 16s-7.2 16-16 16H144c-8.8 0-16-7.2-16-16s7.2-16 16-16z"></path>
    </svg>
  </span>
  <div class="content">
    <slot />
  </div>
</aside>

<style>
  .read-more {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    margin-block: 0.5rem 0.8rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
  }

  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    flex: 0 0 1.5rem;
    margin-top: 0.1rem;
    color: var(--sl-color-gray-3);
  }

  .icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .content {
    min-width: 0;
    flex: 1 1 auto;
  }

  .content > :global(:first-child) {
    margin-top: 0;
  }

  .content > :global(:last-child) {
    margin-bottom: 0;
  }
</style>
