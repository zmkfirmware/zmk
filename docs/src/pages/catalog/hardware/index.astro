---
import { getCollection } from "astro:content";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

import metadata from "@data/hardware-metadata.json";
import HardwareCatalog from "@components/catalog/hardware/HardwareCatalog.tsx";
import type {
  HardwareCatalogItem,
  HardwareInterconnectOption,
} from "@/lib/hardware-catalog-search";

const entries = await getCollection("hardware");

const interconnectNames = new Map<string, string>(
  metadata
    .filter((item) => item.type === "interconnect")
    .map((item) => [item.id, item.name])
);
const interconnectIds = new Set<string>();

for (const entry of entries) {
  for (const id of entry.data.type === "shield" ? entry.data.requires : []) {
    interconnectIds.add(id);
  }

  for (const id of entry.data.exposes ?? []) {
    interconnectIds.add(id);
  }
}

const interconnects: HardwareInterconnectOption[] = [...interconnectIds]
  .map((id) => ({
    id,
    name: interconnectNames.get(id) ?? id,
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const items: HardwareCatalogItem[] = entries.map((entry) => {
  const { data } = entry;
  const variants =
    data.variants?.map((variant) =>
      typeof variant === "string" ? variant : variant.id
    ) ?? [];

  return {
    href: `/catalog/hardware/${data.type}/${data.slug}`,
    slug: data.slug,
    id: data.id,
    name: data.name,
    type: data.type,
    category: data.category,
    ...(data.manufacturer ? { manufacturer: data.manufacturer } : {}),
    ...(data.description ? { description: data.description } : {}),
    features: data.features ?? [],
    requires: data.type === "shield" ? data.requires : [],
    exposes: data.exposes ?? [],
    siblings: data.siblings ?? [],
    variants,
    ...(data.type === "board"
      ? { arch: data.arch, outputs: data.outputs }
      : {}),
    targets: data.targets.map((target) => ({
      id: target.id,
      name: target.name,
    })),
  };
});
---

<StarlightPage
  frontmatter={{
    title: "Hardware Catalog",
    description:
      "Boards and shields supported by ZMK, generated from the hardware metadata files in the firmware repository.",
    tableOfContents: false,
  }}
  hasSidebar={false}
>
  <HardwareCatalog client:load items={items} interconnects={interconnects} />
</StarlightPage>
