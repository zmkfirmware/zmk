---
import { getCollection } from "astro:content";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

import {
  HARDWARE_CATEGORY_SECTION_LABELS,
  type HardwareCategory,
} from "@/lib/hardware-catalog";

interface CatalogSection {
  id: string;
  category: HardwareCategory;
  description?: string;
}

const sections: CatalogSection[] = [
  {
    id: "boards-controller",
    category: "controller",
    description:
      "Controller boards pair with a separate shield over an interconnect.",
  },
  {
    id: "boards-keyboard",
    category: "keyboard",
    description: "Keyboards with an onboard controller.",
  },
  {
    id: "shields",
    category: "shield",
  },
];

const entries = await getCollection("hardware");

const groupedSections = sections.map((section) => ({
  ...section,
  heading: HARDWARE_CATEGORY_SECTION_LABELS[section.category],
  entries: entries
    .filter((entry) => entry.data.category === section.category)
    .sort((a, b) => a.data.name.localeCompare(b.data.name)),
}));

const headings = groupedSections.map((section) => ({
  depth: 2,
  slug: section.id,
  text: `${section.heading} — ${section.entries.length}`,
}));
---

<StarlightPage
  frontmatter={{
    title: "Hardware Catalog",
    description:
      "Boards and shields supported by ZMK, generated from the hardware metadata files in the firmware repository.",
  }}
  headings={headings}
  hasSidebar={false}
>
  <p>
    This catalog is generated from the <code>.zmk.yml</code> metadata files in
    the ZMK repository. Select a board or shield to see its metadata and
    documentation.
  </p>

  {groupedSections.map((section) => (
    <section>
      <h2 id={section.id}>
        {`${section.heading} — ${section.entries.length}`}
      </h2>
      {section.description && <p>{section.description}</p>}
      <ul class="hardware-catalog-list">
        {section.entries.map((entry) => (
          <li>
            <a href={`/catalog/hardware/${entry.data.type}/${entry.data.slug}`}>
              {entry.data.name}
            </a>{" "}
            <code>{entry.data.id}</code>
          </li>
        ))}
      </ul>
    </section>
  ))}
</StarlightPage>

<style>
  section + section {
    margin-block-start: 2rem;
  }

  .hardware-catalog-list code {
    font-size: var(--sl-text-sm);
  }
</style>
