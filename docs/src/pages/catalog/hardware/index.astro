---
import { getCollection } from "astro:content";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

import HardwareCatalog from "@components/catalog/hardware/HardwareCatalog.tsx";
import {
  hardwareVariantIds,
  isHardwareDeviceEntry,
} from "@/lib/hardware-catalog";
import type {
  HardwareCatalogItem,
  HardwareInterconnectOption,
} from "@/lib/hardware-catalog-search";

const entries = await getCollection("hardware");
const devices = entries.filter(isHardwareDeviceEntry);

const interconnectNames = new Map<string, string>(
  entries
    .filter((entry) => entry.data.type === "interconnect")
    .map((entry) => [entry.data.id, entry.data.name])
);
const interconnectIds = new Set<string>();

for (const entry of devices) {
  for (const id of entry.data.type === "shield" ? entry.data.requires : []) {
    interconnectIds.add(id);
  }

  for (const id of entry.data.exposes ?? []) {
    interconnectIds.add(id);
  }
}

const interconnects: HardwareInterconnectOption[] = [...interconnectIds]
  .map((id) => ({
    id,
    name: interconnectNames.get(id) ?? id,
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const items: HardwareCatalogItem[] = devices.map((entry) => {
  const { data } = entry;

  return {
    href: `/catalog/hardware/${data.type}/${data.slug}`,
    slug: data.slug,
    id: data.id,
    name: data.name,
    type: data.type,
    category: data.category,
    manufacturer: data.manufacturer,
    description: data.description,
    features: data.features ?? [],
    requires: data.type === "shield" ? data.requires : [],
    exposes: data.exposes ?? [],
    siblings: data.siblings ?? [],
    variants: hardwareVariantIds(data.variants),
    arch: data.type === "board" ? data.arch : undefined,
    outputs: data.type === "board" ? data.outputs : undefined,
    targets: data.targets.map((target) => ({
      id: target.id,
      name: target.name,
    })),
  };
});
---

<StarlightPage
  frontmatter={{
    title: "Hardware Catalog",
    description:
      "Boards and shields supported by ZMK, generated from the hardware metadata files in the firmware repository.",
    tableOfContents: false,
  }}
  hasSidebar={false}
>
  <HardwareCatalog client:load items={items} interconnects={interconnects} />
</StarlightPage>
