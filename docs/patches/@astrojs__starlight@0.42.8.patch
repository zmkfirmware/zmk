diff --git a/dist/utils/canonical.js b/dist/utils/canonical.js
index 893f720620317e85ee8bfa9b259cfc7f0ed1c191..504e0db0a44b557991503e9155040902f4a366c0 100644
--- a/dist/utils/canonical.js
+++ b/dist/utils/canonical.js
@@ -5,9 +5,25 @@ const canonicalTrailingSlashStrategies = {
 	never: stripTrailingSlash,
 	ignore: ensureTrailingSlash
 };
+/**
+ * `build.format: "preserve"` emits flat `foo.html` files, but Starlight
+ * treats their URLs as extensionless elsewhere (links, site title, search).
+ * Strip the generated HTML filename so canonical/og:url match those URLs.
+ */
+function stripPreserveHtmlExtension(href) {
+	const url = new URL(href);
+	if (url.pathname.endsWith("/index.html")) {
+		url.pathname = url.pathname.slice(0, -"index.html".length);
+		if (url.pathname.length > 1) url.pathname = url.pathname.slice(0, -1);
+	} else if (url.pathname.endsWith(".html")) {
+		url.pathname = url.pathname.slice(0, -".html".length);
+	}
+	return url.href;
+}
 /** Format a canonical link based on the project config. */
 function formatCanonical(href, opts) {
 	if (opts.format === "file") return href;
+	if (opts.format === "preserve") href = stripPreserveHtmlExtension(href);
 	return canonicalTrailingSlashStrategies[opts.trailingSlash](href);
 }
 //#endregion
